<Application x:Class="ReceiptSystem.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ReceiptSystem.Desktop.Converters"
             StartupUri="Views/LoginWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>

            <!-- Converters -->
            <conv:NullToCollapsedConverter x:Key="NullToCollapsed"/>
            <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>

            <!-- ═══════════════════════════════════════ -->
            <!-- COLOR PALETTE — Premium Dark Theme     -->
            <!-- ═══════════════════════════════════════ -->
            <Color x:Key="BgDeep">#FF12121A</Color>
            <Color x:Key="BgSurface">#FF1A1A2E</Color>
            <Color x:Key="BgCard">#FF222240</Color>
            <Color x:Key="BgCardHover">#FF2A2A50</Color>
            <Color x:Key="BgInput">#FF16162A</Color>
            <Color x:Key="BorderSubtle">#FF333366</Color>
            <Color x:Key="BorderFocus">#FF667EEA</Color>
            <Color x:Key="AccentPrimary">#FF667EEA</Color>
            <Color x:Key="AccentSecondary">#FF764BA2</Color>
            <Color x:Key="AccentSuccess">#FF22C55E</Color>
            <Color x:Key="AccentDanger">#FFEF4444</Color>
            <Color x:Key="AccentWarning">#FFFBBF24</Color>
            <Color x:Key="TextPrimary">#FFF0F0F5</Color>
            <Color x:Key="TextSecondary">#FF9090B0</Color>
            <Color x:Key="TextMuted">#FF606080</Color>

            <SolidColorBrush x:Key="BgDeepBrush" Color="{StaticResource BgDeep}" />
            <SolidColorBrush x:Key="BgSurfaceBrush" Color="{StaticResource BgSurface}" />
            <SolidColorBrush x:Key="BgCardBrush" Color="{StaticResource BgCard}" />
            <SolidColorBrush x:Key="BgCardHoverBrush" Color="{StaticResource BgCardHover}" />
            <SolidColorBrush x:Key="BgInputBrush" Color="{StaticResource BgInput}" />
            <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtle}" />
            <SolidColorBrush x:Key="BorderFocusBrush" Color="{StaticResource BorderFocus}" />
            <SolidColorBrush x:Key="AccentPrimaryBrush" Color="{StaticResource AccentPrimary}" />
            <SolidColorBrush x:Key="AccentSecondaryBrush" Color="{StaticResource AccentSecondary}" />
            <SolidColorBrush x:Key="AccentSuccessBrush" Color="{StaticResource AccentSuccess}" />
            <SolidColorBrush x:Key="AccentDangerBrush" Color="{StaticResource AccentDanger}" />
            <SolidColorBrush x:Key="AccentWarningBrush" Color="{StaticResource AccentWarning}" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMuted}" />

            <!-- Custom Accents and UI State Brushes for Module 2 -->
            <!-- We already have AccentPrimaryBrush. The gradient uses AccentSecondary. -->
            <SolidColorBrush x:Key="RowHoverBrush" Color="#2A2A3D"/>
            <SolidColorBrush x:Key="RowSelectedBrush" Color="#1A3A2A"/>
            <SolidColorBrush x:Key="RowBorderBrush" Color="#33334A"/>
            
            <SolidColorBrush x:Key="BadgeNeutralBgBrush" Color="#2E2E42"/>
            <SolidColorBrush x:Key="BadgeNeutralTextBrush" Color="#9CA3AF"/>
            
            <SolidColorBrush x:Key="DashedCardBorderBrush" Color="#7C8FF0"/>
            <SolidColorBrush x:Key="DashedCardBgBrush" Color="#22223A"/>
            
            <SolidColorBrush x:Key="DragHandleBrush" Color="#5A5A70"/>

            <!-- Row flash animation highlight (light green for success feedback) -->
            <SolidColorBrush x:Key="FlashHighlightBrush" Color="#A5D6A7"/>
            <!-- Success background at 8% opacity (for checked/selected rows) -->
            <SolidColorBrush x:Key="SelectedSuccessBgBrush" Color="#FF22C55E" Opacity="0.08"/>
            <!-- Sidebar nav button states (AccentPrimary at 15% and 10%) -->
            <SolidColorBrush x:Key="NavSelectedBrush" Color="#26667EEA"/>
            <SolidColorBrush x:Key="NavHoverBrush" Color="#1A667EEA"/>

            <!-- Gradient Brushes -->
            <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{StaticResource AccentPrimary}" Offset="0" />
                <GradientStop Color="{StaticResource AccentSecondary}" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="SidebarGradient" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FF0F0F1A" Offset="0" />
                <GradientStop Color="#FF1A1A30" Offset="1" />
            </LinearGradientBrush>

            <!-- ═══════════════════════════════════════ -->
            <!-- GLOBAL STYLES                          -->
            <!-- ═══════════════════════════════════════ -->

            <!-- Default TextBlock -->
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="14" />
            </Style>

            <!-- Modern Button -->
            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource AccentGradient}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="24,12" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="8"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Opacity" Value="0.85" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Opacity" Value="0.7" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="border" Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Secondary (outline) Button -->
            <Style x:Key="SecondaryButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource AccentPrimaryBrush}" />
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="24,12" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                                    Background="Transparent"
                                    BorderBrush="{StaticResource BorderSubtleBrush}"
                                    BorderThickness="1.5"
                                    CornerRadius="8"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background">
                                        <Setter.Value>
                                            <SolidColorBrush Color="{StaticResource AccentPrimary}" Opacity="0.1" />
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Global TextBox defaults — ensures text is always visible on dark backgrounds -->
            <Style TargetType="TextBox">
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="CaretBrush" Value="{StaticResource AccentPrimaryBrush}" />
                <Setter Property="SelectionBrush" Value="{StaticResource AccentPrimaryBrush}" />
            </Style>

            <!-- Modern TextBox — no custom template, uses default WPF template for reliable text rendering -->
            <Style x:Key="ModernTextBox" TargetType="TextBox">
                <Setter Property="Background" Value="{StaticResource BgInputBrush}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="CaretBrush" Value="White" />
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="BorderThickness" Value="1.5" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
                <Setter Property="SelectionBrush" Value="{StaticResource AccentPrimaryBrush}" />
            </Style>

            <!-- Modern PasswordBox -->
            <Style x:Key="ModernPasswordBox" TargetType="PasswordBox">
                <Setter Property="Background" Value="{StaticResource BgInputBrush}" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="CaretBrush" Value="{StaticResource AccentPrimaryBrush}" />
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Padding" Value="12,10" />
                <Setter Property="BorderThickness" Value="1.5" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="PasswordBox">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8"
                                    Padding="{TemplateBinding Padding}">
                                <ScrollViewer x:Name="PART_ContentHost" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BorderFocusBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Dark ComboBox Toggle Button -->
            <Style x:Key="DarkComboBoxToggle" TargetType="ToggleButton">
                <Setter Property="Background" Value="{StaticResource BgInputBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
                <Setter Property="BorderThickness" Value="1.5" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="ClickMode" Value="Press" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="32"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0"/>
                                    <Path Grid.Column="1" Data="M0,0 L4,4 L8,0"
                                          Stroke="{StaticResource TextSecondaryBrush}"
                                          StrokeThickness="1.5" HorizontalAlignment="Center"
                                          VerticalAlignment="Center" Margin="0,2,0,0"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BorderFocusBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Dark ComboBox (Full Template) -->
            <Style TargetType="ComboBox">
                <Setter Property="Background" Value="{StaticResource BgInputBrush}" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="12,10" />
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <ToggleButton x:Name="ToggleButton"
                                              Style="{StaticResource DarkComboBoxToggle}"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                                <ContentPresenter x:Name="ContentSite"
                                                  IsHitTestVisible="False"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  Margin="14,8,32,8"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Right"/>
                                <Popup x:Name="Popup" Placement="Bottom"
                                       IsOpen="{TemplateBinding IsDropDownOpen}"
                                       AllowsTransparency="True" Focusable="False"
                                       PopupAnimation="Slide">
                                    <Grid x:Name="DropDown"
                                          MinWidth="{TemplateBinding ActualWidth}"
                                          MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                          SnapsToDevicePixels="True">
                                        <Border x:Name="DropDownBorder"
                                                Background="{StaticResource BgCardBrush}"
                                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                                BorderThickness="1" CornerRadius="8"
                                                Margin="0,2,0,0" Padding="0,4">
                                            <ScrollViewer SnapsToDevicePixels="True">
                                                <StackPanel IsItemsHost="True"
                                                            KeyboardNavigation.DirectionalNavigation="Contained"/>
                                            </ScrollViewer>
                                        </Border>
                                    </Grid>
                                </Popup>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Dark ComboBox Items -->
            <Style TargetType="ComboBoxItem">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="Padding" Value="14,10" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="itemBorder"
                                    Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}"
                                    Margin="4,1" CornerRadius="6">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="itemBorder" Property="Background" Value="{StaticResource AccentPrimaryBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="itemBorder" Property="Background" Value="{StaticResource AccentPrimaryBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Dark DatePicker -->
            <Style TargetType="DatePicker">
                <Setter Property="Background" Value="{StaticResource BgInputBrush}" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
                <Setter Property="BorderThickness" Value="1.5" />
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="CalendarStyle" Value="{StaticResource DarkCalendarStyle}" />
            </Style>

            <!-- Dark Calendar -->
            <Style x:Key="DarkCalendarStyle" TargetType="Calendar">
                <Setter Property="Background" Value="{StaticResource BgCardBrush}" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CalendarDayButtonStyle" Value="{StaticResource DarkCalendarDayButton}" />
                <Setter Property="CalendarButtonStyle" Value="{StaticResource DarkCalendarButton}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Calendar">
                            <StackPanel x:Name="PART_Root" HorizontalAlignment="Center">
                                <CalendarItem x:Name="PART_CalendarItem"
                                              Background="{StaticResource BgCardBrush}"
                                              BorderBrush="{StaticResource BorderSubtleBrush}"
                                              BorderThickness="1"
                                              Style="{TemplateBinding CalendarItemStyle}" />
                            </StackPanel>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Dark CalendarDayButton (individual day cells) -->
            <Style x:Key="DarkCalendarDayButton" TargetType="CalendarDayButton">
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="MinWidth" Value="32" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CalendarDayButton">
                            <Grid>
                                <Rectangle x:Name="TodayBackground" RadiusX="14" RadiusY="14"
                                           Opacity="0" Fill="{StaticResource AccentPrimaryBrush}" />
                                <Rectangle x:Name="SelectedBackground" RadiusX="14" RadiusY="14"
                                           Opacity="0" Fill="{StaticResource AccentPrimaryBrush}" />
                                <Border x:Name="hoverBorder" Background="Transparent" CornerRadius="14">
                                    <ContentPresenter x:Name="NormalText"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                      Margin="5,1,5,1" />
                                </Border>
                                <Rectangle x:Name="BlackoutVisual" Opacity="0"
                                           Fill="{StaticResource TextMutedBrush}" RadiusX="14" RadiusY="14" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="hoverBorder" Property="Background" Value="{StaticResource RowHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="SelectedBackground" Property="Opacity" Value="0.8" />
                                    <Setter TargetName="NormalText" Property="TextElement.Foreground" Value="White" />
                                </Trigger>
                                <Trigger Property="IsToday" Value="True">
                                    <Setter TargetName="TodayBackground" Property="Opacity" Value="0.25" />
                                    <Setter TargetName="NormalText" Property="TextElement.Foreground" Value="{StaticResource AccentPrimaryBrush}" />
                                    <Setter TargetName="NormalText" Property="TextElement.FontWeight" Value="Bold" />
                                </Trigger>
                                <Trigger Property="IsBlackedOut" Value="True">
                                    <Setter TargetName="BlackoutVisual" Property="Opacity" Value="0.35" />
                                    <Setter TargetName="NormalText" Property="Opacity" Value="0.3" />
                                </Trigger>
                                <Trigger Property="IsInactive" Value="True">
                                    <Setter TargetName="NormalText" Property="TextElement.Foreground" Value="{StaticResource TextMutedBrush}" />
                                </Trigger>
                                <!-- Selected + Today combined -->
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsSelected" Value="True" />
                                        <Condition Property="IsToday" Value="True" />
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="TodayBackground" Property="Opacity" Value="0" />
                                    <Setter TargetName="SelectedBackground" Property="Opacity" Value="0.9" />
                                    <Setter TargetName="NormalText" Property="TextElement.Foreground" Value="White" />
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Dark CalendarButton (month/year/decade navigation cells) -->
            <Style x:Key="DarkCalendarButton" TargetType="CalendarButton">
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="MinWidth" Value="40" />
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CalendarButton">
                            <Grid>
                                <Rectangle x:Name="SelectedBackground" RadiusX="4" RadiusY="4"
                                           Opacity="0" Fill="{StaticResource AccentPrimaryBrush}" />
                                <Border x:Name="hoverBorder" Background="Transparent" CornerRadius="4"
                                        Padding="4">
                                    <ContentPresenter x:Name="NormalText"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="hoverBorder" Property="Background" Value="{StaticResource RowHoverBrush}" />
                                </Trigger>
                                <Trigger Property="HasSelectedDays" Value="True">
                                    <Setter TargetName="SelectedBackground" Property="Opacity" Value="0.7" />
                                    <Setter TargetName="NormalText" Property="TextElement.Foreground" Value="White" />
                                </Trigger>
                                <Trigger Property="IsInactive" Value="True">
                                    <Setter TargetName="NormalText" Property="TextElement.Foreground" Value="{StaticResource TextMutedBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Dark CalendarItem (the main calendar panel with header/navigation) -->
            <Style TargetType="Primitives:CalendarItem"
                   xmlns:Primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework">
                <Setter Property="Background" Value="{StaticResource BgCardBrush}" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Primitives:CalendarItem"
                                         xmlns:Primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework">
                            <ControlTemplate.Resources>
                                <DataTemplate x:Key="{x:Static CalendarItem.DayTitleTemplateResourceKey}">
                                    <TextBlock Text="{Binding}" FontSize="11" FontWeight="Bold"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Margin="0,6,0,6" />
                                </DataTemplate>
                            </ControlTemplate.Resources>
                            <Grid x:Name="PART_Root">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{StaticResource BorderSubtleBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="4">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <!-- Navigation header -->
                                        <Grid Grid.Row="0" Margin="4,4,4,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="PART_PreviousButton" Grid.Column="0"
                                                    Content="◀" Background="Transparent" BorderThickness="0"
                                                    Foreground="{StaticResource TextSecondaryBrush}"
                                                    FontSize="12" Cursor="Hand" Padding="8,4"
                                                    HorizontalAlignment="Left" />
                                            <Button x:Name="PART_HeaderButton" Grid.Column="1"
                                                    Background="Transparent" BorderThickness="0"
                                                    Foreground="{StaticResource TextPrimaryBrush}"
                                                    FontWeight="Bold" FontSize="14" Cursor="Hand"
                                                    HorizontalAlignment="Center" />
                                            <Button x:Name="PART_NextButton" Grid.Column="2"
                                                    Content="▶" Background="Transparent" BorderThickness="0"
                                                    Foreground="{StaticResource TextSecondaryBrush}"
                                                    FontSize="12" Cursor="Hand" Padding="8,4"
                                                    HorizontalAlignment="Right" />
                                        </Grid>
                                        <!-- Day/Month/Year grid -->
                                        <Grid x:Name="PART_MonthView" Grid.Row="1" Visibility="Visible">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" /><RowDefinition Height="*" />
                                                <RowDefinition Height="*" /><RowDefinition Height="*" />
                                                <RowDefinition Height="*" /><RowDefinition Height="*" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                        </Grid>
                                        <Grid x:Name="PART_YearView" Grid.Row="1" Visibility="Hidden">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" /><RowDefinition Height="*" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Dark CheckBox -->
            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="FontFamily" Value="Segoe UI" />
            </Style>

            <!-- Dark TabControl -->
            <Style TargetType="TabControl">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabControl">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Margin="20,0,20,8">
                                    <TabPanel IsItemsHost="True" Background="Transparent" />
                                </Border>
                                <ContentPresenter Grid.Row="1" ContentSource="SelectedContent" Margin="0" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Dark TabItem -->
            <Style TargetType="TabItem">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                <Setter Property="Padding" Value="24,12" />
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="border" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" BorderThickness="0,0,0,3" BorderBrush="Transparent">
                                <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#11FFFFFF" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource AccentPrimaryBrush}" />
                                    <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentPrimaryBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
