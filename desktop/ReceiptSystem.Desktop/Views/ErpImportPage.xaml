<UserControl x:Class="ReceiptSystem.Desktop.Views.ErpImportPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <Grid x:Name="RootGrid" Background="{StaticResource BgSurfaceBrush}">
        <!-- Tab Headers -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource BgCardBrush}" Margin="24,20,24,0" CornerRadius="12,12,0,0" Padding="16,10">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="TabUpload" Content="📤 رفع ومعاينة" GroupName="ErpTab" IsChecked="True"
                             Checked="Tab_Changed" Style="{x:Null}" Cursor="Hand"
                             FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,24,0"/>
                <RadioButton x:Name="TabBatches" Content="📦 الدُفعات النشطة" GroupName="ErpTab"
                             Checked="Tab_Changed" Style="{x:Null}" Cursor="Hand"
                             FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
            </StackPanel>
        </Border>

        <!-- ═══ TAB 1: UPLOAD & PREVIEW ═══ -->
        <Border x:Name="UploadPanel" Grid.Row="1" Background="{StaticResource BgCardBrush}"
                Margin="24,0,24,20" CornerRadius="0,0,12,12" Padding="20,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- File picker -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                    <Button x:Name="PickFileBtn" Content="📁 اختيار ملف Excel" Style="{StaticResource SecondaryButton}"
                            Click="PickFile_Click" Padding="16,8" FontSize="13"/>
                    <TextBlock x:Name="SelectedFileName" Text="لم يتم اختيار ملف" FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>

                <!-- Warnings -->
                <Border x:Name="PreviewWarnings" Grid.Row="1" Background="#33FBBF24" CornerRadius="8"
                        Padding="12,8" Margin="0,0,0,10" Visibility="Collapsed"
                        BorderBrush="{StaticResource AccentWarningBrush}" BorderThickness="1">
                    <TextBlock x:Name="PreviewWarningsText" TextWrapping="Wrap" FontSize="12"
                               Foreground="{StaticResource AccentWarningBrush}"/>
                </Border>

                <!-- Preview grid -->
                <DataGrid x:Name="PreviewGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" Background="Transparent" BorderThickness="0"
                          RowBackground="{StaticResource BgCardBrush}"
                          AlternatingRowBackground="{StaticResource BgSurfaceBrush}"
                          Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{StaticResource BorderSubtleBrush}"
                          HeadersVisibility="Column">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="{StaticResource BgDeepBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                            <Setter Property="Padding" Value="8,6"/>
                            <Setter Property="FontSize" Value="11"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding rowIndex}" Width="40"/>
                        <DataGridTextColumn Header="اسم التاجر (خام)" Binding="{Binding merchantNameRaw}" Width="*"/>
                        <DataGridTextColumn Header="المبلغ" Binding="{Binding amount}" Width="100"/>
                        <DataGridTextColumn Header="التاجر المطابق" Binding="{Binding matchedName}" Width="*"/>
                        <DataGridTextColumn Header="حالة المطابقة" Binding="{Binding matchStatus}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Commit button -->
                <Button x:Name="CommitPreviewBtn" Grid.Row="3" Content="✓ تأكيد وإنشاء الدُفعة"
                        Style="{StaticResource PrimaryButton}" Click="CommitPreview_Click"
                        Padding="20,10" FontSize="14" Margin="0,12,0,0" HorizontalAlignment="Left"
                        Visibility="Collapsed"/>
            </Grid>
        </Border>

        <!-- ═══ TAB 2: ACTIVE BATCHES ═══ -->
        <Border x:Name="BatchesPanel" Grid.Row="1" Background="{StaticResource BgCardBrush}"
                Margin="24,0,24,20" CornerRadius="0,0,12,12" Padding="0" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*" MinWidth="340"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Batch detail table -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Batch selector -->
                    <Border Grid.Row="0" Background="{StaticResource BgDeepBrush}" Padding="12,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="الدُفعة:" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="BatchCombo" Width="250" Height="34"
                                      DisplayMemberPath="display" SelectedValuePath="batchId"
                                      SelectionChanged="BatchCombo_Changed"/>
                            <Button Content="⟳" Style="{StaticResource SecondaryButton}" Padding="8,4"
                                    Click="RefreshBatches_Click" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Batch rows with checkboxes -->
                    <DataGrid x:Name="BatchRowsGrid" Grid.Row="1" AutoGenerateColumns="False"
                              CanUserAddRows="False" Background="Transparent" BorderThickness="0"
                              RowBackground="{StaticResource BgCardBrush}"
                              AlternatingRowBackground="{StaticResource BgSurfaceBrush}"
                              Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{StaticResource BorderSubtleBrush}"
                              HeadersVisibility="Column" SelectionMode="Extended">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{StaticResource BgDeepBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                <Setter Property="Padding" Value="8,6"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="✓" Binding="{Binding isSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="40"/>
                            <DataGridTextColumn Header="#" Binding="{Binding rowIndex}" Width="40" IsReadOnly="True"/>
                            <DataGridTextColumn Header="التاجر" Binding="{Binding merchantName}" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="المبلغ" Binding="{Binding amount}" Width="90" IsReadOnly="True"/>
                            <DataGridTextColumn Header="مُعيّن" Binding="{Binding assignedDisplay}" Width="80" IsReadOnly="True"/>
                            <DataGridTextColumn Header="رقم الإيصال" Binding="{Binding assignedReceipt}" Width="100" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- Right: Assignment panel -->
                <Border Grid.Column="1" Background="{StaticResource BgInputBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1,0,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,14">
                        <StackPanel>
                            <!-- Block Assignment -->
                            <TextBlock Text="تعيين كتلة" FontSize="15" FontWeight="Bold" Margin="0,0,0,12"/>

                            <TextBlock x:Name="SelectedCountLabel" Text="المحددة: 0 صف" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>

                            <TextBlock Text="السائق" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="BlockDriverCombo" Height="34" Margin="0,0,0,8"
                                      DisplayMemberPath="fullName" SelectedValuePath="driverId"/>

                            <TextBlock Text="تاريخ الجلسة" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <DatePicker x:Name="BlockSessionDate" Height="34" FlowDirection="LeftToRight" Margin="0,0,0,8"/>

                            <TextBlock Text="رقم أول إيصال" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="BlockStartReceipt" Style="{StaticResource ModernTextBox}" Height="34" Margin="0,0,0,8"/>

                            <TextBlock Text="المنطقة / الخط" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="BlockRouteArea" Style="{StaticResource ModernTextBox}" Height="34" Margin="0,0,0,12"/>

                            <Button x:Name="AssignBlockBtn" Content="تعيين الكتلة" Style="{StaticResource PrimaryButton}"
                                    Click="AssignBlock_Click" Padding="16,8" FontSize="13"/>

                            <Border Height="1" Background="{StaticResource BorderSubtleBrush}" Margin="0,16"/>

                            <!-- Single Orphan Assignment -->
                            <TextBlock Text="تعيين فردي (يتيم)" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                            <TextBlock Text="رقم الجلسة المستهدفة" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="SingleSessionIdBox" Style="{StaticResource ModernTextBox}" Height="34" Margin="0,0,0,8"/>
                            <TextBlock Text="رقم الإيصال" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="SingleReceiptBox" Style="{StaticResource ModernTextBox}" Height="34" Margin="0,0,0,12"/>
                            <Button Content="تعيين فردي" Style="{StaticResource SecondaryButton}"
                                    Click="AssignSingle_Click" Padding="14,6" FontSize="12"/>

                            <Border Height="1" Background="{StaticResource BorderSubtleBrush}" Margin="0,16"/>

                            <!-- Reconcile -->
                            <TextBlock Text="تسوية الدُفعة" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                            <TextBlock Text="إجمالي دفتر الأستاذ" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="LedgerTotalBox" Style="{StaticResource ModernTextBox}" Height="34"
                                     FlowDirection="LeftToRight" TextAlignment="Right" Margin="0,0,0,8"/>
                            <TextBlock Text="النقد الفعلي" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="ActualCashTotalBox" Style="{StaticResource ModernTextBox}" Height="34"
                                     FlowDirection="LeftToRight" TextAlignment="Right" Margin="0,0,0,12"/>
                            <Button Content="تسوية" Style="{StaticResource SecondaryButton}"
                                    Click="ReconcileBatch_Click" Padding="14,6" FontSize="12"/>

                            <Border Height="1" Background="{StaticResource BorderSubtleBrush}" Margin="0,16"/>

                            <!-- Complete -->
                            <Button x:Name="CompleteBatchBtn" Content="✓ إتمام الدُفعة" Style="{StaticResource PrimaryButton}"
                                    Click="CompleteBatch_Click" Padding="16,8" FontSize="14"
                                    Foreground="White"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>

        <!-- Loading -->
        <Border x:Name="LoadingOverlay" Grid.RowSpan="2" Background="#88000000" Visibility="Collapsed">
            <TextBlock Text="⏳ جاري المعالجة..." FontSize="16" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>
