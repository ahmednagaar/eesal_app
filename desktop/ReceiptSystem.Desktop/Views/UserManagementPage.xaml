<UserControl x:Class="ReceiptSystem.Desktop.Views.UserManagementPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <Grid x:Name="RootGrid" Background="{StaticResource BgSurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ HEADER BAR ═══ -->
        <Border Grid.Row="0" Background="{StaticResource BgCardBrush}" CornerRadius="12" Padding="16,12" Margin="24,20,24,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="👥 إدارة المستخدمين" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="➕ مستخدم جديد" Style="{StaticResource PrimaryButton}"
                        Padding="14,8" FontSize="13" Click="AddUser_Click"/>
            </Grid>
        </Border>

        <!-- ═══ USERS GRID ═══ -->
        <Border Grid.Row="1" Background="{StaticResource BgCardBrush}" CornerRadius="12" Margin="24,12,24,20">
            <DataGrid x:Name="UsersGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" Background="Transparent" BorderThickness="0"
                      RowBackground="{StaticResource BgCardBrush}"
                      AlternatingRowBackground="{StaticResource BgSurfaceBrush}"
                      Foreground="{StaticResource TextPrimaryBrush}"
                      FontSize="13" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{StaticResource BorderSubtleBrush}"
                      HeadersVisibility="Column" MouseDoubleClick="UsersGrid_DoubleClick">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{StaticResource BgDeepBrush}"/>
                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                        <Setter Property="Padding" Value="12,10"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="12,8"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.CellStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="اسم المستخدم" Binding="{Binding username}" Width="150"/>
                    <DataGridTextColumn Header="الاسم الكامل" Binding="{Binding fullName}" Width="*"/>
                    <DataGridTextColumn Header="الدور" Binding="{Binding roleAr}" Width="120"/>
                    <DataGridTextColumn Header="الحالة" Binding="{Binding statusText}" Width="80"/>
                    <DataGridTextColumn Header="آخر دخول" Binding="{Binding lastLogin}" Width="140"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Loading -->
        <Border x:Name="LoadingOverlay" Grid.RowSpan="2" Background="#88000000" Visibility="Collapsed">
            <TextBlock Text="⏳ جاري التحميل..." FontSize="16" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>
