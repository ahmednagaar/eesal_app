<UserControl x:Class="ReceiptSystem.Desktop.Views.GapReviewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <Grid x:Name="RootGrid" Background="{StaticResource BgSurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ SUMMARY CARDS ═══ -->
        <UniformGrid Grid.Row="0" Columns="4" Margin="24,20,24,0">
            <Border Background="{StaticResource BgCardBrush}" CornerRadius="12" Padding="16,12" Margin="0,0,12,0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="مفتوحة" FontSize="12" Foreground="{StaticResource AccentDangerBrush}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="StatOpen" Text="—" FontSize="24" FontWeight="Bold"
                               Foreground="{StaticResource AccentDangerBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Border Background="{StaticResource BgCardBrush}" CornerRadius="12" Padding="16,12" Margin="0,0,12,0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="قيد التحقيق" FontSize="12" Foreground="{StaticResource AccentWarningBrush}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="StatInvestigation" Text="—" FontSize="24" FontWeight="Bold"
                               Foreground="{StaticResource AccentWarningBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Border Background="{StaticResource BgCardBrush}" CornerRadius="12" Padding="16,12" Margin="0,0,12,0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="تم الحل" FontSize="12" Foreground="{StaticResource AccentSuccessBrush}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="StatResolved" Text="—" FontSize="24" FontWeight="Bold"
                               Foreground="{StaticResource AccentSuccessBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Border Background="{StaticResource BgCardBrush}" CornerRadius="12" Padding="16,12">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="الإجمالي" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="StatTotal" Text="—" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- ═══ FILTER ═══ -->
        <Border Grid.Row="1" Background="{StaticResource BgCardBrush}" CornerRadius="12" Padding="16,10" Margin="24,12,24,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="الحالة:" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="StatusFilter" Width="180" Height="34" SelectionChanged="StatusFilter_Changed">
                    <ComboBoxItem Content="— الكل —" Tag="" IsSelected="True"/>
                    <ComboBoxItem Content="مفتوحة" Tag="Open"/>
                    <ComboBoxItem Content="قيد التحقيق" Tag="UnderInvestigation"/>
                    <ComboBoxItem Content="تم الحل" Tag="Resolved"/>
                    <ComboBoxItem Content="مُوضّحة" Tag="Explained"/>
                </ComboBox>
                <Button Content="⟳  تحديث" Style="{StaticResource SecondaryButton}" Padding="12,6" FontSize="12"
                        Margin="12,0,0,0" Click="Refresh_Click" Height="34"/>
            </StackPanel>
        </Border>

        <!-- ═══ GAPS GRID ═══ -->
        <Border Grid.Row="2" Background="{StaticResource BgCardBrush}" CornerRadius="12" Margin="24,12,24,20" Padding="0">
            <Grid>
                <DataGrid x:Name="GapsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          Background="Transparent" BorderThickness="0"
                          RowBackground="{StaticResource BgCardBrush}"
                          AlternatingRowBackground="{StaticResource BgSurfaceBrush}"
                          Foreground="{StaticResource TextPrimaryBrush}"
                          FontSize="13" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{StaticResource BorderSubtleBrush}"
                          HeadersVisibility="Column" SelectionMode="Single">

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="{StaticResource BgDeepBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                            <Setter Property="Padding" Value="12,10"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="12,8"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.CellStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="رقم الإيصال المفقود" Binding="{Binding missingNumber}" Width="140"/>
                        <DataGridTextColumn Header="السائق" Binding="{Binding driverName}" Width="*"/>
                        <DataGridTextColumn Header="تاريخ الاكتشاف" Binding="{Binding detectedAt}" Width="120"/>
                        <DataGridTextColumn Header="الحالة" Binding="{Binding statusDisplay}" Width="100"/>
                        <DataGridTextColumn Header="التوضيح" Binding="{Binding resolution}" Width="*"/>
                        <DataGridTextColumn Header="حُلّت بواسطة" Binding="{Binding resolvedBy}" Width="120"/>
                        <DataGridTemplateColumn Header="إجراء" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="حل" Style="{StaticResource SecondaryButton}"
                                            Padding="10,4" FontSize="11" Click="ResolveRow_Click"
                                            Tag="{Binding gapId}" Cursor="Hand"
                                            Visibility="{Binding canResolve}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock x:Name="EmptyState" Text="لا توجد فجوات" Visibility="Collapsed"
                           FontSize="14" Foreground="{StaticResource TextMutedBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ═══ RESOLVE DIALOG ═══ -->
        <Border x:Name="ResolveDialog" Grid.RowSpan="3" Background="#CC000000" Visibility="Collapsed">
            <Border Background="{StaticResource BgCardBrush}" CornerRadius="16" Padding="32,24"
                    MaxWidth="450" HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="{StaticResource AccentPrimaryBrush}" BorderThickness="2">
                <StackPanel>
                    <TextBlock Text="حل الفجوة" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <TextBlock x:Name="ResolveGapInfo" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,16"/>

                    <TextBlock Text="الحالة الجديدة:" FontSize="13" Margin="0,0,0,6"/>
                    <ComboBox x:Name="ResolveStatus" Height="36" Margin="0,0,0,12">
                        <ComboBoxItem Content="تم الحل" Tag="Resolved" IsSelected="True"/>
                        <ComboBoxItem Content="قيد التحقيق" Tag="UnderInvestigation"/>
                        <ComboBoxItem Content="مُوضّحة" Tag="Explained"/>
                    </ComboBox>

                    <TextBlock Text="التوضيح / السبب:" FontSize="13" Margin="0,0,0,6"/>
                    <TextBox x:Name="ResolveResolution" Style="{StaticResource ModernTextBox}"
                             Height="80" TextWrapping="Wrap" AcceptsReturn="True"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                        <Button Content="حفظ" Style="{StaticResource PrimaryButton}" Padding="20,8"
                                Click="ResolveConfirm_Click" Margin="0,0,8,0"/>
                        <Button Content="إلغاء" Style="{StaticResource SecondaryButton}" Padding="16,8"
                                Click="ResolveCancel_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Loading -->
        <Border x:Name="LoadingOverlay" Grid.RowSpan="3" Background="#88000000" Visibility="Collapsed">
            <TextBlock Text="⏳ جاري التحميل..." FontSize="16" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>
