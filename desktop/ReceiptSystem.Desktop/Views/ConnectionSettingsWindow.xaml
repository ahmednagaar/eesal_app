<Window x:Class="ReceiptSystem.Desktop.Views.ConnectionSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إعدادات الاتصال"
        Width="400" Height="250"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FlowDirection="RightToLeft">

    <Border CornerRadius="12" Background="{StaticResource BgSurfaceBrush}"
            BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Border Grid.Row="0" Background="{StaticResource BgDeepBrush}"
                    CornerRadius="12,12,0,0" MouseLeftButtonDown="TitleBar_MouseDown"
                    BorderThickness="0,0,0,1" BorderBrush="{StaticResource BorderSubtleBrush}">
                <Grid>
                    <TextBlock Text="⚙️ إعدادات الاتصال" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center" Margin="16,12"/>
                    <Button Content="✕" HorizontalAlignment="Left" VerticalAlignment="Center"
                            Margin="10,0" Click="Close_Click"
                            Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"
                            BorderThickness="0" FontSize="16" Cursor="Hand" Padding="6,2"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="24">
                <TextBlock Text="عنوان السيرفر (API URL)" FontSize="13" Margin="0,0,0,8"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBox x:Name="UrlBox" Style="{StaticResource ModernTextBox}"
                         FlowDirection="LeftToRight" FontSize="14" Margin="0,0,0,24"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="إلغاء" Style="{StaticResource SecondaryButton}" Padding="16,8" Margin="0,0,12,0"
                            Click="Close_Click"/>
                    <Button Content="💾 حفظ" Style="{StaticResource PrimaryButton}" Padding="16,8"
                            Click="Save_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
