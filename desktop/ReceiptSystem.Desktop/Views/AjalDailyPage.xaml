<UserControl x:Class="ReceiptSystem.Desktop.Views.AjalDailyPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">

    <Grid x:Name="RootGrid" Background="{StaticResource BgDeepBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource BgCardBrush}" CornerRadius="12" Margin="16,16,16,8" Padding="20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="📋 السجل اليومي — حسب الخط" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Text="التاريخ:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <DatePicker x:Name="dpDate" SelectedDateFormat="Short" Width="150"
                                SelectedDateChanged="DpDate_Changed"/>
                    <Button Content="🔄 تحميل" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="BtnLoad_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Sessions list grouped by route -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="16,0,16,8">
            <StackPanel x:Name="pnlSessions"/>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{StaticResource BgCardBrush}" CornerRadius="12" Margin="16,0,16,16" Padding="16,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="📥 تصدير Excel" Style="{StaticResource PrimaryButton}" MinWidth="130" Click="BtnExport_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
