<UserControl x:Class="ReceiptSystem.Desktop.Views.MerchantsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">

    <Grid Background="{StaticResource BgSurfaceBrush}">
        <!-- Main Content -->
        <DockPanel Margin="24,20">

            <!-- Header -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
                <TextBlock Text="🏪  التجار" FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center"/>
                <Button Content="➕  إضافة تاجر" Style="{StaticResource PrimaryButton}"
                        Click="AddMerchant_Click" HorizontalAlignment="Left"
                        Padding="20,10" FontSize="13"/>
            </Grid>

            <!-- Search Bar -->
            <Border DockPanel.Dock="Top" CornerRadius="10" Margin="0,0,0,16"
                    Background="{StaticResource BgCardBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                    Padding="4">
                <Grid>
                    <TextBox x:Name="SearchBox" Style="{StaticResource ModernTextBox}"
                             TextChanged="Search_TextChanged" FontSize="14"
                             BorderThickness="0" Background="Transparent"/>
                    <TextBlock x:Name="SearchPlaceholder" Text="🔍  بحث عن تاجر..."
                               FontSize="14" Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center" Margin="12,0"
                               IsHitTestVisible="False"/>
                </Grid>
            </Border>

            <!-- Pagination Info -->
            <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
                <TextBlock x:Name="PageInfoText" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Right"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button x:Name="PrevBtn" Content="◀  السابق" Style="{StaticResource SecondaryButton}"
                            Click="PrevPage_Click" Padding="16,8" FontSize="12" Margin="0,0,8,0"/>
                    <Button x:Name="NextBtn" Content="التالي  ▶" Style="{StaticResource SecondaryButton}"
                            Click="NextPage_Click" Padding="16,8" FontSize="12"/>
                </StackPanel>
            </Grid>

            <!-- Data Table -->
            <Border CornerRadius="12" Background="{StaticResource BgCardBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">

                <DataGrid x:Name="MerchantsGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          Background="Transparent"
                          Foreground="{StaticResource TextPrimaryBrush}"
                          BorderThickness="0"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{StaticResource BorderSubtleBrush}"
                          HeadersVisibility="Column"
                          SelectionMode="Single"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          FontFamily="Segoe UI"
                          FontSize="14"
                          RowHeight="48"
                          ColumnHeaderHeight="44">

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="{StaticResource BgDeepBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="Padding" Value="16,10"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{StaticResource BgCardHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource BgCardHoverBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="16,8"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.CellStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="اسم التاجر" Binding="{Binding merchantName}" Width="*"/>
                        <DataGridTextColumn Header="المدينة" Binding="{Binding city}" Width="150"/>
                        <DataGridTextColumn Header="الهاتف" Binding="{Binding phoneNumber}" Width="150"/>
                        <DataGridTemplateColumn Header="إجراءات" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="✏️" Background="Transparent" BorderThickness="0"
                                            Foreground="{StaticResource AccentPrimaryBrush}"
                                            FontSize="16" Cursor="Hand" Padding="8,4"
                                            Click="EditMerchant_Click" Tag="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </DockPanel>

        <!-- ═══ ADD/EDIT DIALOG OVERLAY ═══ -->
        <Grid x:Name="DialogOverlay" Visibility="Collapsed" Background="#88000000">
            <Border Background="{StaticResource BgCardBrush}" CornerRadius="16"
                    BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                    Padding="28" MaxWidth="450" VerticalAlignment="Center"
                    HorizontalAlignment="Center" MinWidth="400">
                <StackPanel>
                    <TextBlock x:Name="DialogTitle" Text="إضافة تاجر جديد"
                               FontSize="20" FontWeight="Bold" Margin="0,0,0,20"
                               Foreground="{StaticResource TextPrimaryBrush}"/>

                    <TextBlock Text="اسم التاجر" FontSize="12" Margin="0,0,0,6"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBox x:Name="MerchantNameBox" Style="{StaticResource ModernTextBox}" Margin="0,0,0,14"/>

                    <TextBlock Text="المدينة" FontSize="12" Margin="0,0,0,6"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBox x:Name="CityBox" Style="{StaticResource ModernTextBox}" Margin="0,0,0,14"/>

                    <TextBlock Text="الهاتف" FontSize="12" Margin="0,0,0,6"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBox x:Name="MerchantPhoneBox" Style="{StaticResource ModernTextBox}" Margin="0,0,0,14"
                             FlowDirection="LeftToRight"/>

                    <TextBlock Text="ملاحظات" FontSize="12" Margin="0,0,0,6"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBox x:Name="MerchantNotesBox" Style="{StaticResource ModernTextBox}" Margin="0,0,0,20"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"/>

                    <TextBlock x:Name="DialogError" Foreground="{StaticResource AccentDangerBrush}"
                               FontSize="13" Margin="0,0,0,12" Visibility="Collapsed"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="💾  حفظ" Style="{StaticResource PrimaryButton}"
                                Click="SaveMerchant_Click" Padding="24,10" FontSize="14"
                                Margin="0,0,10,0"/>
                        <Button Content="إلغاء" Style="{StaticResource SecondaryButton}"
                                Click="CancelDialog_Click" Padding="24,10" FontSize="14"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
