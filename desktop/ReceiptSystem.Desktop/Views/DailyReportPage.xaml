<UserControl x:Class="ReceiptSystem.Desktop.Views.DailyReportPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <Grid x:Name="RootGrid" Background="{StaticResource BgSurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ DATE + PRINT BAR ═══ -->
        <Border Grid.Row="0" Background="{StaticResource BgCardBrush}" CornerRadius="12" Padding="16,12" Margin="24,20,24,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="التاريخ:" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <DatePicker x:Name="ReportDate" Height="36" Width="160"/>
                <Button Content="⟳  عرض التقرير" Style="{StaticResource PrimaryButton}" Padding="16,6" FontSize="13"
                        Click="LoadReport_Click" Margin="12,0,0,0" Height="36"/>
                <Button x:Name="PrintBtn" Content="🖨️  طباعة" Style="{StaticResource SecondaryButton}" Padding="14,6" FontSize="13"
                        Click="Print_Click" Margin="12,0,0,0" Height="36" IsEnabled="False"/>
            </StackPanel>
        </Border>

        <!-- ═══ SUMMARY CARDS ═══ -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="24,12,24,0">
            <Border Background="{StaticResource BgCardBrush}" CornerRadius="10" Padding="14,10" Margin="0,0,10,0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="السائقون" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="StatDrivers" Text="—" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Border Background="{StaticResource BgCardBrush}" CornerRadius="10" Padding="14,10" Margin="0,0,10,0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="الإيصالات" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="StatReceipts" Text="—" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Border Background="{StaticResource BgCardBrush}" CornerRadius="10" Padding="14,10" Margin="0,0,10,0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="الإجمالي" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="StatTotal" Text="—" FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource AccentPrimaryBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Border Background="{StaticResource BgCardBrush}" CornerRadius="10" Padding="14,10">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="إيصالات مفقودة" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="StatMissing" Text="—" FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource AccentDangerBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- ═══ PER-DRIVER SECTIONS ═══ -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="24,12,24,20">
            <StackPanel x:Name="DriverSections"/>
        </ScrollViewer>

        <!-- Loading -->
        <Border x:Name="LoadingOverlay" Grid.RowSpan="3" Background="#88000000" Visibility="Collapsed">
            <TextBlock Text="⏳ جاري التحميل..." FontSize="16" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>
