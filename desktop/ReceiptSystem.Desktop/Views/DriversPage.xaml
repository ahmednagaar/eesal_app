<UserControl x:Class="ReceiptSystem.Desktop.Views.DriversPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">

    <Grid Background="{StaticResource BgSurfaceBrush}">
        <!-- Main Content -->
        <DockPanel Margin="24,20">

            <!-- Header -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,20">
                <TextBlock Text="🚛  السائقون" FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center"/>
                <Button Content="➕  إضافة سائق" Style="{StaticResource PrimaryButton}"
                        Click="AddDriver_Click" HorizontalAlignment="Left"
                        Padding="20,10" FontSize="13"/>
            </Grid>

            <!-- Data Table -->
            <Border CornerRadius="12" Background="{StaticResource BgCardBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                    Padding="0">

                <DataGrid x:Name="DriversGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          Background="Transparent"
                          Foreground="{StaticResource TextPrimaryBrush}"
                          BorderThickness="0"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{StaticResource BorderSubtleBrush}"
                          HeadersVisibility="Column"
                          SelectionMode="Single"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          FontFamily="Segoe UI"
                          FontSize="14"
                          RowHeight="48"
                          ColumnHeaderHeight="44">

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="{StaticResource BgDeepBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="Padding" Value="16,10"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{StaticResource BgCardHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource BgCardHoverBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="16,8"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.CellStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الاسم" Binding="{Binding fullName}" Width="*"
                                            FontSize="14"/>
                        <DataGridTextColumn Header="الهاتف" Binding="{Binding phoneNumber}" Width="150"/>
                        <DataGridTextColumn Header="فجوات مفتوحة" Binding="{Binding openGapsCount}" Width="120"/>
                        <DataGridTemplateColumn Header="إجراءات" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="✏️" Background="Transparent" BorderThickness="0"
                                                Foreground="{StaticResource AccentPrimaryBrush}"
                                                FontSize="16" Cursor="Hand" Padding="8,4"
                                                Click="EditDriver_Click" Tag="{Binding}"/>
                                        <Button Content="🗑️" Background="Transparent" BorderThickness="0"
                                                Foreground="{StaticResource AccentDangerBrush}"
                                                FontSize="16" Cursor="Hand" Padding="8,4"
                                                Click="DeleteDriver_Click" Tag="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </DockPanel>

        <!-- ═══ ADD/EDIT DIALOG OVERLAY ═══ -->
        <Grid x:Name="DialogOverlay" Visibility="Collapsed" Background="#88000000">
            <Border Background="{StaticResource BgCardBrush}" CornerRadius="16"
                    BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                    Padding="28" MaxWidth="450" VerticalAlignment="Center"
                    HorizontalAlignment="Center" MinWidth="400">
                <StackPanel>
                    <TextBlock x:Name="DialogTitle" Text="إضافة سائق جديد"
                               FontSize="20" FontWeight="Bold" Margin="0,0,0,20"
                               Foreground="{StaticResource TextPrimaryBrush}"/>

                    <TextBlock Text="الاسم الكامل" FontSize="12" Margin="0,0,0,6"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBox x:Name="NameBox" Style="{StaticResource ModernTextBox}" Margin="0,0,0,14"/>

                    <TextBlock Text="رقم الهاتف" FontSize="12" Margin="0,0,0,6"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBox x:Name="PhoneBox" Style="{StaticResource ModernTextBox}" Margin="0,0,0,14"
                             FlowDirection="LeftToRight"/>

                    <TextBlock Text="ملاحظات" FontSize="12" Margin="0,0,0,6"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBox x:Name="NotesBox" Style="{StaticResource ModernTextBox}" Margin="0,0,0,20"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"/>

                    <TextBlock x:Name="DialogError" Foreground="{StaticResource AccentDangerBrush}"
                               FontSize="13" Margin="0,0,0,12" Visibility="Collapsed"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="💾  حفظ" Style="{StaticResource PrimaryButton}"
                                Click="SaveDriver_Click" Padding="24,10" FontSize="14"
                                Margin="0,0,10,0"/>
                        <Button Content="إلغاء" Style="{StaticResource SecondaryButton}"
                                Click="CancelDialog_Click" Padding="24,10" FontSize="14"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
