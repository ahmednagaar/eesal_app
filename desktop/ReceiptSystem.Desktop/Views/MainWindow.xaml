<Window x:Class="ReceiptSystem.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="نظام البستاوي"
        Width="1200" Height="750"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{StaticResource BgDeepBrush}"
        FlowDirection="RightToLeft">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ SIDEBAR ═══ -->
        <Border Grid.Column="0" Background="{StaticResource SidebarGradient}"
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- App Logo / Header -->
                <Border DockPanel.Dock="Top" Padding="20,24,20,20"
                        BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <TextBlock Text="📦" FontSize="32" HorizontalAlignment="Center"/>
                        <TextBlock Text="نظام البستاوي" FontSize="18" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,6,0,2"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="UserNameText" Text="مرحباً" FontSize="12"
                                   HorizontalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Logout at bottom -->
                <Border DockPanel.Dock="Bottom" Padding="12,12"
                        BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
                    <Button Content="🚪  تسجيل الخروج" Style="{StaticResource SecondaryButton}"
                            Click="Logout_Click" FontSize="13" Height="40"/>
                </Border>

                <!-- Navigation Items -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8">
                    <StackPanel Margin="0,16,0,0">

                        <StackPanel x:Name="NavReceiptSection">
                        <!-- ═══ SECTION: RECEIPT SYSTEM ═══ -->
                        <TextBlock Text="نظام الإيصالات" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="24,8,24,4"/>

                        <!-- Dashboard -->
                        <RadioButton GroupName="Nav" Tag="ReceiptDashboard" IsChecked="True"
                                     Checked="Nav_Click" Style="{x:Null}" Cursor="Hand">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="navBorder" Padding="16,14" Margin="8,2"
                                            CornerRadius="10" Background="Transparent">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Text="لوحة التحكم" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="navBorder" Property="Background" Value="{StaticResource NavSelectedBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="navBorder" Property="Background" Value="{StaticResource NavHoverBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>

                        <!-- New Session -->
                        <RadioButton GroupName="Nav" Tag="NewSession"
                                     Checked="Nav_Click" Style="{x:Null}" Cursor="Hand">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="navBorder" Padding="16,14" Margin="8,2"
                                            CornerRadius="10" Background="Transparent">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Text="جلسة جديدة" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="navBorder" Property="Background" Value="{StaticResource NavSelectedBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="navBorder" Property="Background" Value="{StaticResource NavHoverBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>

                        <!-- Sessions -->
                        <RadioButton GroupName="Nav" Tag="Sessions"
                                     Checked="Nav_Click" Style="{x:Null}" Cursor="Hand">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="navBorder" Padding="16,14" Margin="8,2"
                                            CornerRadius="10" Background="Transparent">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Text="الجلسات" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="navBorder" Property="Background" Value="{StaticResource NavSelectedBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="navBorder" Property="Background" Value="{StaticResource NavHoverBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>

                        <!-- Gaps -->
                        <RadioButton GroupName="Nav" Tag="GapReview"
                                     Checked="Nav_Click" Style="{x:Null}" Cursor="Hand">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="navBorder" Padding="16,14" Margin="8,2"
                                            CornerRadius="10" Background="Transparent">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Text="الفجوات" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="navBorder" Property="Background" Value="{StaticResource NavSelectedBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="navBorder" Property="Background" Value="{StaticResource NavHoverBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>

                        <!-- Receipt Books -->
                        <RadioButton GroupName="Nav" Tag="ReceiptBooks"
                                     Checked="Nav_Click" Style="{x:Null}" Cursor="Hand">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="navBorder" Padding="16,14" Margin="8,2"
                                            CornerRadius="10" Background="Transparent">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE82D;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Text="دفاتر الإيصالات" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="navBorder" Property="Background" Value="{StaticResource NavSelectedBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="navBorder" Property="Background" Value="{StaticResource NavHoverBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>

                        <!-- ERP Import -->
                        <RadioButton GroupName="Nav" Tag="ErpImport"
                                     Checked="Nav_Click" Style="{x:Null}" Cursor="Hand">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="navBorder" Padding="16,14" Margin="8,2"
                                            CornerRadius="10" Background="Transparent">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Text="استيراد ERP" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="navBorder" Property="Background" Value="{StaticResource NavSelectedBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="navBorder" Property="Background" Value="{StaticResource NavHoverBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>

                        <!-- Separator -->
                        <Border Height="1" Background="{StaticResource BorderSubtleBrush}" Margin="16,8"/>

                        <!-- ═══ SECTION: REPORTS ═══ -->
                        <TextBlock Text="التقارير" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="24,8,24,4"/>

                        <!-- Daily Report -->
                        <RadioButton GroupName="Nav" Tag="DailyReport"
                                     Checked="Nav_Click" Style="{x:Null}" Cursor="Hand">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="navBorder" Padding="16,14" Margin="8,2"
                                            CornerRadius="10" Background="Transparent">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE9F9;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Text="التقرير اليومي" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="navBorder" Property="Background" Value="{StaticResource NavSelectedBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="navBorder" Property="Background" Value="{StaticResource NavHoverBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>

                        <!-- Search -->
                        <RadioButton GroupName="Nav" Tag="ReceiptSearch"
                                     Checked="Nav_Click" Style="{x:Null}" Cursor="Hand">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="navBorder" Padding="16,14" Margin="8,2"
                                            CornerRadius="10" Background="Transparent">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Text="بحث الإيصالات" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="navBorder" Property="Background" Value="{StaticResource NavSelectedBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="navBorder" Property="Background" Value="{StaticResource NavHoverBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>

                        <!-- Driver Performance -->
                        <RadioButton GroupName="Nav" Tag="DriverPerformance"
                                     Checked="Nav_Click" Style="{x:Null}" Cursor="Hand">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="navBorder" Padding="16,14" Margin="8,2"
                                            CornerRadius="10" Background="Transparent">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Text="أداء السائقين" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="navBorder" Property="Background" Value="{StaticResource NavSelectedBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="navBorder" Property="Background" Value="{StaticResource NavHoverBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>

                        <!-- Separator -->
                        <Border Height="1" Background="{StaticResource BorderSubtleBrush}" Margin="16,8"/>
                        </StackPanel>

                        <!-- ═══ SECTION: ROUTE SYSTEM ═══ -->
                        <TextBlock Text="نظام الخطوط" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="24,8,24,4"/>

                        <RadioButton GroupName="Nav" Tag="RouteSetup"
                                     Checked="Nav_Click" Style="{x:Null}" Cursor="Hand">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="navBorder" Padding="16,14" Margin="8,2"
                                            CornerRadius="10" Background="Transparent">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🗺️" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="الخطوط والتجار" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="navBorder" Property="Background" Value="{StaticResource NavSelectedBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="navBorder" Property="Background" Value="{StaticResource NavHoverBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>

                        <RadioButton GroupName="Nav" Tag="DailyInvoices"
                                     Checked="Nav_Click" Style="{x:Null}" Cursor="Hand">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="navBorder" Padding="16,14" Margin="8,2"
                                            CornerRadius="10" Background="Transparent">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📋" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="فواتير اليوم" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="navBorder" Property="Background" Value="{StaticResource NavSelectedBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="navBorder" Property="Background" Value="{StaticResource NavHoverBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>

                        <RadioButton GroupName="Nav" Tag="RouteHistory"
                                     Checked="Nav_Click" Style="{x:Null}" Cursor="Hand">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="navBorder" Padding="16,14" Margin="8,2"
                                            CornerRadius="10" Background="Transparent">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📜" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="سجل الخطوط" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="navBorder" Property="Background" Value="{StaticResource NavSelectedBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="navBorder" Property="Background" Value="{StaticResource NavHoverBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>

                        <!-- Separator -->
                        <Border Height="1" Background="{StaticResource BorderSubtleBrush}" Margin="16,8"/>

                        <!-- ═══ SECTION: MASTER DATA ═══ -->
                        <TextBlock Text="البيانات الأساسية" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="24,8,24,4"/>

                        <RadioButton GroupName="Nav" Tag="Drivers"
                                     Checked="Nav_Click" Style="{x:Null}" Cursor="Hand">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="navBorder" Padding="16,14" Margin="8,2"
                                            CornerRadius="10" Background="Transparent">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🚛" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="السائقون" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="navBorder" Property="Background" Value="{StaticResource NavSelectedBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="navBorder" Property="Background" Value="{StaticResource NavHoverBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>

                        <RadioButton GroupName="Nav" Tag="Merchants"
                                     Checked="Nav_Click" Style="{x:Null}" Cursor="Hand">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="navBorder" Padding="16,14" Margin="8,2"
                                            CornerRadius="10" Background="Transparent">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🏪" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="التجار" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="navBorder" Property="Background" Value="{StaticResource NavSelectedBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="navBorder" Property="Background" Value="{StaticResource NavHoverBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>

                        <!-- Separator -->
                        <Border Height="1" Background="{StaticResource BorderSubtleBrush}" Margin="16,8"/>

                        <!-- ═══ SECTION: AJAL (دفتر الآجل) ═══ -->
                        <TextBlock Text="دفتر الآجل" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="24,8,24,4"/>

                        <!-- Ajal Daily Register -->
                        <RadioButton GroupName="Nav" Tag="AjalDaily"
                                     Checked="Nav_Click" Style="{x:Null}" Cursor="Hand">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="navBorder" Padding="16,14" Margin="8,2"
                                            CornerRadius="10" Background="Transparent">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📋" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="السجل اليومي" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="navBorder" Property="Background" Value="{StaticResource NavSelectedBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="navBorder" Property="Background" Value="{StaticResource NavHoverBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>

                        <!-- Ajal Entry -->
                        <RadioButton GroupName="Nav" Tag="AjalEntry"
                                     Checked="Nav_Click" Style="{x:Null}" Cursor="Hand">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="navBorder" Padding="16,14" Margin="8,2"
                                            CornerRadius="10" Background="Transparent">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="✏️" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="إدخال فواتير" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="navBorder" Property="Background" Value="{StaticResource NavSelectedBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="navBorder" Property="Background" Value="{StaticResource NavHoverBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>

                        <!-- Ajal Search -->
                        <RadioButton GroupName="Nav" Tag="AjalSearch"
                                     Checked="Nav_Click" Style="{x:Null}" Cursor="Hand">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="navBorder" Padding="16,14" Margin="8,2"
                                            CornerRadius="10" Background="Transparent">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🔍" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="بحث الآجل" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="navBorder" Property="Background" Value="{StaticResource NavSelectedBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="navBorder" Property="Background" Value="{StaticResource NavHoverBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>

                        <!-- Ajal Employee Performance -->
                        <RadioButton GroupName="Nav" Tag="AjalEmployeePerf"
                                     Checked="Nav_Click" Style="{x:Null}" Cursor="Hand">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="navBorder" Padding="16,14" Margin="8,2"
                                            CornerRadius="10" Background="Transparent">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="👥" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="أداء الموظفين" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="navBorder" Property="Background" Value="{StaticResource NavSelectedBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="navBorder" Property="Background" Value="{StaticResource NavHoverBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>

                        <!-- Ajal Merchant History -->
                        <RadioButton GroupName="Nav" Tag="AjalMerchantHistory"
                                     Checked="Nav_Click" Style="{x:Null}" Cursor="Hand">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="navBorder" Padding="16,14" Margin="8,2"
                                            CornerRadius="10" Background="Transparent">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📊" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="كشف حساب تاجر" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="navBorder" Property="Background" Value="{StaticResource NavSelectedBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
