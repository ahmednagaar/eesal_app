<UserControl x:Class="ReceiptSystem.Desktop.Views.CameraAuditPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Loaded="Page_Loaded">

    <Grid Background="{StaticResource BgSurfaceBrush}">
        <DockPanel Margin="24,20">

            <!-- Header -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="📹  مراجعة الكاميرا" FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                <Button Grid.Column="1" Content="➕ مراجعة جديدة" Style="{StaticResource PrimaryButton}"
                        Click="AddAudit_Click" Padding="20,10" FontSize="13" VerticalAlignment="Center"/>
            </Grid>

            <!-- Filters -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <TextBox x:Name="AuditDriverFilterSearchBox" FontSize="14" Padding="10,8"
                             TextChanged="AuditDriverFilterSearch_TextChanged" GotFocus="AuditDriverFilterSearch_GotFocus"/>
                    <Button x:Name="ClearAuditDriverFilterBtn" Content="✕" FontSize="9" Visibility="Collapsed"
                            HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0"
                            Width="18" Height="18" Padding="0" Cursor="Hand" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextMutedBrush}" Click="ClearAuditDriverFilter_Click"/>
                    <Popup x:Name="AuditDriverFilterPopup" PlacementTarget="{Binding ElementName=AuditDriverFilterSearchBox}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                        <Border Background="{StaticResource BgCardBrush}" CornerRadius="8" BorderBrush="{StaticResource AccentPrimaryBrush}" BorderThickness="1" Padding="0" Margin="0,2,0,0" MinWidth="200">
                            <Border.Effect><DropShadowEffect BlurRadius="12" Opacity="0.3" ShadowDepth="4"/></Border.Effect>
                            <ListBox x:Name="AuditDriverFilterResults" MaxHeight="200" BorderThickness="0" Background="Transparent" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" SelectionChanged="AuditDriverFilterResults_SelectionChanged">
                                <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="8,6"/><Setter Property="Cursor" Value="Hand"/></Style></ListBox.ItemContainerStyle>
                            </ListBox>
                        </Border>
                    </Popup>
                </Grid>
                <ComboBox x:Name="AuditStatusFilter" Grid.Column="2" FontSize="14" Padding="10,8"
                          SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="كل الحالات" Tag="" IsSelected="True"/>
                    <ComboBoxItem Content="مسودة" Tag="Draft"/>
                    <ComboBoxItem Content="مكتمل" Tag="Completed"/>
                    <ComboBoxItem Content="يوجد فروقات" Tag="HasDiscrepancies"/>
                </ComboBox>
                <DatePicker x:Name="AuditFromDate" Grid.Column="4" FontSize="13" SelectedDateChanged="Filter_Changed"/>
                <DatePicker x:Name="AuditToDate" Grid.Column="6" FontSize="13" SelectedDateChanged="Filter_Changed"/>
                <Button Grid.Column="8" Content="🔄" Style="{StaticResource SecondaryButton}"
                        Click="Refresh_Click" Padding="12,8" FontSize="14"/>
            </Grid>

            <!-- Audits Grid -->
            <Border CornerRadius="12" Background="{StaticResource BgCardBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                <DataGrid x:Name="AuditsGrid"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          Background="Transparent" Foreground="{StaticResource TextPrimaryBrush}"
                          BorderThickness="0" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{StaticResource BorderSubtleBrush}"
                          RowBackground="Transparent" AlternatingRowBackground="#08FFFFFF"
                          HeadersVisibility="Column" CanUserResizeRows="False"
                          SelectionMode="Single" FontSize="14"
                          MouseDoubleClick="AuditsGrid_DoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="التاريخ" Binding="{Binding [auditDate], StringFormat=\{0:yyyy-MM-dd\}}" Width="110"/>
                        <DataGridTextColumn Header="السائق" Binding="{Binding [driverName]}" Width="150"/>
                        <DataGridTextColumn Header="رقم الرحلة" Binding="{Binding [tripReference]}" Width="120"/>
                        <DataGridTextColumn Header="الحالة" Binding="{Binding [status]}" Width="120"/>
                        <DataGridTextColumn Header="الفروقات" Binding="{Binding [discrepancyCount]}" Width="80"/>
                        <DataGridTextColumn Header="مفتوحة" Binding="{Binding [openDiscrepancyCount]}" Width="80"/>
                        <DataGridTextColumn Header="المراجع" Binding="{Binding [reviewedByUserName]}" Width="130"/>
                        <DataGridTemplateColumn Header="إجراءات" Width="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="📋 تفاصيل" Tag="{Binding}" Click="ViewAudit_Click"
                                                Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="12" Margin="2"/>
                                        <Button Content="🗑️" Tag="{Binding}" Click="DeleteAudit_Click"
                                                Style="{StaticResource SecondaryButton}" Padding="6,4" FontSize="12" Margin="2"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </DockPanel>

        <!-- ═══ CREATE AUDIT DIALOG ═══ -->
        <Grid x:Name="AuditDialog" Visibility="Collapsed" Background="#88000000">
            <Border CornerRadius="16" Background="{StaticResource BgCardBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                    Width="520" VerticalAlignment="Center" Padding="28,24">
                <StackPanel>
                    <TextBlock Text="مراجعة كاميرا جديدة" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>
                    <TextBlock Text="السائق:" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,12">
                        <TextBox x:Name="AuditDialogDriverSearchBox" FontSize="14" Padding="10,8"
                                 TextChanged="AuditDialogDriverSearch_TextChanged" GotFocus="AuditDialogDriverSearch_GotFocus"/>
                        <Button x:Name="ClearAuditDialogDriverBtn" Content="✕" FontSize="9" Visibility="Collapsed"
                                HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0"
                                Width="18" Height="18" Padding="0" Cursor="Hand" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextMutedBrush}" Click="ClearAuditDialogDriver_Click"/>
                        <Popup x:Name="AuditDialogDriverPopup" PlacementTarget="{Binding ElementName=AuditDialogDriverSearchBox}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                            <Border Background="{StaticResource BgCardBrush}" CornerRadius="8" BorderBrush="{StaticResource AccentPrimaryBrush}" BorderThickness="1" Padding="0" Margin="0,2,0,0" MinWidth="250">
                                <Border.Effect><DropShadowEffect BlurRadius="12" Opacity="0.3" ShadowDepth="4"/></Border.Effect>
                                <ListBox x:Name="AuditDialogDriverResults" MaxHeight="200" BorderThickness="0" Background="Transparent" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" SelectionChanged="AuditDialogDriverResults_SelectionChanged">
                                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="8,6"/><Setter Property="Cursor" Value="Hand"/></Style></ListBox.ItemContainerStyle>
                                </ListBox>
                            </Border>
                        </Popup>
                    </Grid>
                    <TextBlock Text="التاريخ:" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <DatePicker x:Name="AuditDatePicker" FontSize="13" Margin="0,0,0,12"/>
                    <TextBlock Text="رقم الرحلة (اختياري):" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="TripRefBox" FontSize="14" Padding="10,8" Margin="0,0,0,12"/>
                    <TextBlock Text="ملاحظات:" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="AuditNotesBox" FontSize="14" Padding="10,8" Margin="0,0,0,12" TextWrapping="Wrap" Height="60"/>
                    <TextBlock x:Name="AuditDialogError" Foreground="#FF6B6B" FontSize="13" Visibility="Collapsed" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,8,0,0">
                        <Button Content="إنشاء" Style="{StaticResource PrimaryButton}" Click="CreateAudit_Click" Padding="24,10" FontSize="14"/>
                        <Button Content="إلغاء" Style="{StaticResource SecondaryButton}" Click="CancelAuditDialog_Click" Padding="24,10" FontSize="14" Margin="12,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══ AUDIT DETAIL VIEW ═══ -->
        <Grid x:Name="DetailView" Visibility="Collapsed" Background="#88000000">
            <Border CornerRadius="16" Background="{StaticResource BgCardBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                    Width="800" MaxHeight="600" VerticalAlignment="Center" Padding="28,24">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Name="DetailTitle" Text="تفاصيل المراجعة" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                        <Button Grid.Column="1" Content="✕ إغلاق" Style="{StaticResource SecondaryButton}" Click="CloseDetail_Click"
                                Padding="12,6" FontSize="13" VerticalAlignment="Center"/>
                    </Grid>
                    <DataGrid x:Name="DiscrepanciesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              Background="Transparent" Foreground="{StaticResource TextPrimaryBrush}"
                              BorderThickness="0" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{StaticResource BorderSubtleBrush}"
                              RowBackground="Transparent" HeadersVisibility="Column"
                              CanUserResizeRows="False" FontSize="13">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الصنف" Binding="{Binding [productName]}" Width="*"/>
                            <DataGridTextColumn Header="الوحدة" Binding="{Binding [unitName]}" Width="80"/>
                            <DataGridTextColumn Header="المتوقع" Binding="{Binding [expectedQty]}" Width="80"/>
                            <DataGridTextColumn Header="الفعلي" Binding="{Binding [actualQty]}" Width="80"/>
                            <DataGridTextColumn Header="الفرق" Binding="{Binding [differenceQty]}" Width="80"/>
                            <DataGridTextColumn Header="النوع" Binding="{Binding [discrepancyType]}" Width="90"/>
                            <DataGridTextColumn Header="الحالة" Binding="{Binding [status]}" Width="100"/>
                            <DataGridTemplateColumn Header="" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="تحديث الحالة" Tag="{Binding}" Click="UpdateStatus_Click"
                                                Style="{StaticResource SecondaryButton}" Padding="6,3" FontSize="11"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
