<UserControl x:Class="ReceiptSystem.Desktop.Views.ReceiptBooksPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <Grid x:Name="RootGrid" Background="{StaticResource BgSurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="*" MinWidth="320"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ LEFT: BOOKS LIST ═══ -->
        <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource BgCardBrush}"
                CornerRadius="12" Margin="24,20,12,0" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Background="{StaticResource BgDeepBrush}" CornerRadius="12,12,0,0" Padding="16,12">
                    <Grid>
                        <TextBlock Text="دفاتر الإيصالات" FontSize="16" FontWeight="Bold"/>
                        <Button Content="⟳" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                                Padding="10,4" Click="Refresh_Click" FontSize="14"/>
                    </Grid>
                </Border>

                <DataGrid x:Name="BooksGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" Background="Transparent" BorderThickness="0"
                          RowBackground="{StaticResource BgCardBrush}"
                          AlternatingRowBackground="{StaticResource BgSurfaceBrush}"
                          Foreground="{StaticResource TextPrimaryBrush}"
                          FontSize="13" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{StaticResource BorderSubtleBrush}"
                          HeadersVisibility="Column" SelectionMode="Single"
                          SelectionChanged="BooksGrid_SelectionChanged">

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="{StaticResource BgDeepBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="FontSize" Value="11"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="10,6"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.CellStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="رقم الدفتر" Binding="{Binding bookNumber}" Width="90"/>
                        <DataGridTextColumn Header="من" Binding="{Binding startReceipt}" Width="80"/>
                        <DataGridTextColumn Header="إلى" Binding="{Binding endReceipt}" Width="80"/>
                        <DataGridTextColumn Header="الحالة" Binding="{Binding statusDisplay}" Width="90"/>
                        <DataGridTextColumn Header="السائق" Binding="{Binding driverName}" Width="*"/>
                        <DataGridTextColumn Header="المتبقي" Binding="{Binding remaining}" Width="70"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- ═══ RIGHT: ACTION PANEL ═══ -->
        <Border Grid.Row="0" Grid.Column="1" Background="{StaticResource BgCardBrush}"
                CornerRadius="12" Margin="0,20,24,0" Padding="20,16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Tab-like toggle -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <RadioButton x:Name="TabCreate" Content="إنشاء دفتر" GroupName="BookTab"
                                     IsChecked="True" Checked="Tab_Changed" Style="{x:Null}" Cursor="Hand"
                                     FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,16,0"/>
                        <RadioButton x:Name="TabAssign" Content="تعيين لسائق" GroupName="BookTab"
                                     Checked="Tab_Changed" Style="{x:Null}" Cursor="Hand"
                                     FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>

                    <!-- Create Book Form -->
                    <StackPanel x:Name="CreatePanel">
                        <TextBlock Text="رقم الدفتر" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="NewBookNumber" Style="{StaticResource ModernTextBox}" Height="36" Margin="0,0,0,10"/>

                        <TextBlock Text="من إيصال رقم" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="NewStartReceipt" Style="{StaticResource ModernTextBox}" Height="36" Margin="0,0,0,10"/>

                        <TextBlock Text="إلى إيصال رقم" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="NewEndReceipt" Style="{StaticResource ModernTextBox}" Height="36" Margin="0,0,0,10"/>

                        <TextBlock Text="ملاحظات" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="NewBookNotes" Style="{StaticResource ModernTextBox}" Height="50" TextWrapping="Wrap" Margin="0,0,0,14"/>

                        <Button x:Name="CreateBtn" Content="إنشاء الدفتر" Style="{StaticResource PrimaryButton}"
                                Click="Create_Click" Padding="16,8" FontSize="13"/>
                    </StackPanel>

                    <!-- Assign Book Form -->
                    <StackPanel x:Name="AssignPanel" Visibility="Collapsed">
                        <TextBlock x:Name="AssignBookLabel" Text="اختر دفتر من القائمة" FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"/>

                        <TextBlock Text="السائق" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="AssignDriverCombo" Height="36" Margin="0,0,0,10"
                                  DisplayMemberPath="fullName" SelectedValuePath="driverId"/>

                        <TextBlock Text="تاريخ التعيين" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <DatePicker x:Name="AssignDate" Height="36" Margin="0,0,0,14"/>

                        <Button x:Name="AssignBtn" Content="تعيين الدفتر" Style="{StaticResource PrimaryButton}"
                                Click="Assign_Click" Padding="16,8" FontSize="13" IsEnabled="False"/>

                        <Border Height="1" Background="{StaticResource BorderSubtleBrush}" Margin="0,16"/>

                        <!-- Edit / Deactivate (visible when book selected) -->
                        <StackPanel x:Name="EditPanel" Visibility="Collapsed">
                            <TextBlock Text="تعديل الدفتر المحدد" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                            <TextBlock Text="ملاحظات" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="EditNotes" Style="{StaticResource ModernTextBox}" Height="50" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="حفظ التعديل" Style="{StaticResource PrimaryButton}"
                                        Click="UpdateBook_Click" Padding="14,6" FontSize="12" Margin="0,0,8,0"/>
                                <Button Content="إلغاء التفعيل" Style="{StaticResource SecondaryButton}"
                                        Click="Deactivate_Click" Padding="14,6" FontSize="12"
                                        Foreground="{StaticResource AccentDangerBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ═══ LOW-STOCK ALERTS ═══ -->
        <Border x:Name="LowStockSection" Grid.Row="1" Grid.ColumnSpan="2"
                Background="#33EF4444" CornerRadius="12" Padding="16,12" Margin="24,12,24,20"
                BorderBrush="{StaticResource AccentDangerBrush}" BorderThickness="1" Visibility="Collapsed">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                               Foreground="{StaticResource AccentDangerBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="دفاتر على وشك النفاد (≤10 إيصالات متبقية)" FontSize="13" FontWeight="Bold"
                               Foreground="{StaticResource AccentDangerBrush}"/>
                </StackPanel>
                <TextBlock x:Name="LowStockText" TextWrapping="Wrap" FontSize="12"/>
            </StackPanel>
        </Border>

        <!-- Loading -->
        <Border x:Name="LoadingOverlay" Grid.RowSpan="2" Grid.ColumnSpan="2" Background="#88000000" Visibility="Collapsed">
            <TextBlock Text="⏳ جاري التحميل..." FontSize="16" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>
