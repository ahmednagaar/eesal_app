<UserControl x:Class="ReceiptSystem.Desktop.Views.NewSessionPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <Grid x:Name="RootGrid" Background="{StaticResource BgSurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ SESSION HEADER ═══ -->
        <Border Grid.Row="0" Background="{StaticResource BgCardBrush}" CornerRadius="12" Padding="20,16" Margin="24,20,24,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 1: Driver + Date + RouteArea -->
                <UniformGrid Grid.Row="0" Columns="3" Margin="0,0,0,12">
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="السائق" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <ComboBox x:Name="DriverCombo" Style="{StaticResource {x:Type ComboBox}}"
                                  DisplayMemberPath="fullName" SelectedValuePath="driverId"
                                  SelectionChanged="DriverCombo_SelectionChanged" Height="40"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="التاريخ" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <DatePicker x:Name="SessionDate" Height="40" FlowDirection="LeftToRight"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="المنطقة / الخط" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <TextBox x:Name="RouteAreaBox" Style="{StaticResource ModernTextBox}" Height="40" MaxLength="200"/>
                    </StackPanel>
                </UniformGrid>

                <!-- Row 2: Book + Last Receipt Hint -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="دفتر الإيصالات" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <ComboBox x:Name="BookCombo" Style="{StaticResource {x:Type ComboBox}}"
                                  DisplayMemberPath="display" SelectedValuePath="bookId" Height="40"/>
                    </StackPanel>

                    <Border Grid.Column="1" Background="{StaticResource BgInputBrush}" CornerRadius="8" Padding="16,8" VerticalAlignment="Bottom">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{StaticResource AccentPrimaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="LastReceiptHint" Text="اختر السائق لعرض آخر إيصال"
                                       FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- ═══ RECEIPT ENTRY LIST ═══ -->
        <Border Grid.Row="1" Margin="24,12,24,0" Background="{StaticResource BgCardBrush}" CornerRadius="12" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Column headers -->
                <Border Grid.Row="0" Background="{StaticResource BgDeepBrush}" CornerRadius="12,12,0,0" Padding="16,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="#" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Column="1" Text="رقم الإيصال" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Column="2" Text="التاجر" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Column="3" Text="المبلغ" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Column="4" Text="جزئي" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="5" Text="ملاحظات" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Column="6" Text="" FontSize="12"/>
                    </Grid>
                </Border>

                <!-- Scrollable receipt rows -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ReceiptRows" Margin="0,4,0,4"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ═══ FOOTER: Totals + Save ═══ -->
        <Border Grid.Row="2" Background="{StaticResource BgCardBrush}" Margin="24,12,24,20" CornerRadius="12" Padding="20,14">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <!-- Running totals -->
                    <Border Background="{StaticResource BgInputBrush}" CornerRadius="8" Padding="16,8" Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="الإيصالات:" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TotalCount" Text="0" FontSize="15" FontWeight="Bold" Margin="0,0,20,0" VerticalAlignment="Center"/>
                            <TextBlock Text="الإجمالي:" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TotalAmount" Text="0.00" FontSize="15" FontWeight="Bold"
                                       Foreground="{StaticResource AccentPrimaryBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="جنيه" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button x:Name="AddRowBtn" Content="＋ إضافة صف" Style="{StaticResource SecondaryButton}"
                            Click="AddRow_Click" Padding="16,8" FontSize="13" Margin="0,0,10,0"/>
                    <Button x:Name="SaveBtn" Content="💾  حفظ الجلسة" Style="{StaticResource PrimaryButton}"
                            Click="Save_Click" Padding="24,8" FontSize="14" Height="42"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Gap Warning Overlay -->
        <Border x:Name="GapWarningOverlay" Grid.RowSpan="3" Background="#CC000000" Visibility="Collapsed">
            <Border Background="{StaticResource BgCardBrush}" CornerRadius="16" Padding="32,24" MaxWidth="500"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="{StaticResource AccentWarningBrush}" BorderThickness="2">
                <StackPanel>
                    <TextBlock Text="⚠️ تحذير: تم اكتشاف فجوات!" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource AccentWarningBrush}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock x:Name="GapWarningText" TextWrapping="Wrap" FontSize="14"
                               HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock x:Name="GapWarningNumbers" TextWrapping="Wrap" FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource AccentDangerBrush}" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    <Button Content="حسناً — تم الحفظ" Style="{StaticResource PrimaryButton}"
                            Click="DismissGapWarning_Click" Padding="24,10" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Border>

        <!-- Loading Overlay -->
        <Border x:Name="LoadingOverlay" Grid.RowSpan="3" Background="#88000000" Visibility="Collapsed">
            <TextBlock Text="⏳ جاري الحفظ..." FontSize="16" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>
