<UserControl x:Class="ReceiptSystem.Desktop.Views.ReturnBooksPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Loaded="Page_Loaded">

    <Grid Background="{StaticResource BgSurfaceBrush}">
        <DockPanel Margin="24,20">

            <!-- Header -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="📗  دفاتر المرتجعات" FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                <Button Grid.Column="1" Content="➕ سلسلة جديدة" Style="{StaticResource PrimaryButton}"
                        Click="AddSeries_Click" Padding="20,10" FontSize="13" VerticalAlignment="Center"/>
            </Grid>

            <!-- Series Selection -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="SeriesCombo" Grid.Column="0"
                          DisplayMemberPath="seriesCode" SelectedValuePath="seriesId"
                          SelectionChanged="SeriesCombo_Changed"
                          FontSize="14" Padding="10,8"/>
                <ComboBox x:Name="StatusFilter" Grid.Column="2" FontSize="14" Padding="10,8"
                          SelectionChanged="StatusFilter_Changed">
                    <ComboBoxItem Content="الكل" Tag="" IsSelected="True"/>
                    <ComboBoxItem Content="متاح" Tag="Available"/>
                    <ComboBoxItem Content="مُسلّم" Tag="Assigned"/>
                    <ComboBoxItem Content="مُرتجع" Tag="Returned"/>
                    <ComboBoxItem Content="مُراجع" Tag="Verified"/>
                </ComboBox>
                <Button Grid.Column="4" Content="🔄 تحديث" Style="{StaticResource SecondaryButton}"
                        Click="Refresh_Click" Padding="16,8" FontSize="13"/>
            </Grid>

            <!-- Books Grid -->
            <Border CornerRadius="12" Background="{StaticResource BgCardBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                <DataGrid x:Name="BooksGrid"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          Background="Transparent" Foreground="{StaticResource TextPrimaryBrush}"
                          BorderThickness="0" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{StaticResource BorderSubtleBrush}"
                          RowBackground="Transparent" AlternatingRowBackground="#08FFFFFF"
                          HeadersVisibility="Column" CanUserResizeRows="False"
                          SelectionMode="Single" FontSize="14">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="رقم الدفتر" Binding="{Binding [bookNumber]}" Width="100"/>
                        <DataGridTextColumn Header="من إيصال" Binding="{Binding [startReceiptNumber]}" Width="100"/>
                        <DataGridTextColumn Header="إلى إيصال" Binding="{Binding [endReceiptNumber]}" Width="100"/>
                        <DataGridTextColumn Header="السائق" Binding="{Binding [assignedToDriverName]}" Width="150"/>
                        <DataGridTextColumn Header="الحالة" Binding="{Binding [status]}" Width="100"/>
                        <DataGridTextColumn Header="تاريخ التسليم" Binding="{Binding [assignedDate], StringFormat=\{0:yyyy-MM-dd\}}" Width="120"/>
                        <DataGridTextColumn Header="مُراجع" Binding="{Binding [isVerifiedText]}" Width="80"/>
                        <DataGridTextColumn Header="عدد المرتجعات" Binding="{Binding [returnsCount]}" Width="110"/>
                        <DataGridTemplateColumn Header="إجراءات" Width="280">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="📤 تسليم" Tag="{Binding}" Click="AssignBook_Click"
                                                Style="{StaticResource PrimaryButton}" Padding="8,4" FontSize="12" Margin="2"/>
                                        <Button Content="📥 استرجاع" Tag="{Binding}" Click="ReturnBook_Click"
                                                Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="12" Margin="2"/>
                                        <Button Content="✅ مراجعة" Tag="{Binding}" Click="VerifyBook_Click"
                                                Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="12" Margin="2"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </DockPanel>

        <!-- ═══ CREATE SERIES DIALOG ═══ -->
        <Grid x:Name="SeriesDialog" Visibility="Collapsed" Background="#88000000">
            <Border CornerRadius="16" Background="{StaticResource BgCardBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                    Width="460" VerticalAlignment="Center" Padding="28,24">
                <StackPanel>
                    <TextBlock Text="إنشاء سلسلة دفاتر جديدة" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>
                    <TextBlock Text="كود السلسلة:" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="SeriesCodeBox" FontSize="14" Padding="10,8" Margin="0,0,0,12"/>
                    <TextBlock Text="عدد الدفاتر:" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="TotalBooksBox" FontSize="14" Padding="10,8" Margin="0,0,0,12" Text="200"/>
                    <TextBlock Text="عدد الإيصالات لكل دفتر:" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="ReceiptsPerBookBox" FontSize="14" Padding="10,8" Margin="0,0,0,12" Text="50"/>
                    <TextBlock x:Name="SeriesDialogError" Foreground="#FF6B6B" FontSize="13" Visibility="Collapsed" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,8,0,0">
                        <Button Content="إنشاء" Style="{StaticResource PrimaryButton}" Click="CreateSeries_Click" Padding="24,10" FontSize="14"/>
                        <Button Content="إلغاء" Style="{StaticResource SecondaryButton}" Click="CancelSeriesDialog_Click" Padding="24,10" FontSize="14" Margin="12,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══ ASSIGN BOOK DIALOG ═══ -->
        <Grid x:Name="AssignDialog" Visibility="Collapsed" Background="#88000000">
            <Border CornerRadius="16" Background="{StaticResource BgCardBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                    Width="420" VerticalAlignment="Center" Padding="28,24">
                <StackPanel>
                    <TextBlock x:Name="AssignDialogTitle" Text="تسليم دفتر لسائق" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>
                    <TextBlock Text="السائق:" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="AssignDriverCombo" DisplayMemberPath="fullName" SelectedValuePath="driverId"
                              FontSize="14" Padding="10,8" Margin="0,0,0,12"/>
                    <TextBlock Text="ملاحظات:" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="AssignNotesBox" FontSize="14" Padding="10,8" Margin="0,0,0,12"/>
                    <TextBlock x:Name="AssignDialogError" Foreground="#FF6B6B" FontSize="13" Visibility="Collapsed" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,8,0,0">
                        <Button Content="تسليم" Style="{StaticResource PrimaryButton}" Click="ConfirmAssign_Click" Padding="24,10" FontSize="14"/>
                        <Button Content="إلغاء" Style="{StaticResource SecondaryButton}" Click="CancelAssignDialog_Click" Padding="24,10" FontSize="14" Margin="12,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
