<UserControl x:Class="ReceiptSystem.Desktop.Views.AjalExcelImportPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <Grid x:Name="RootGrid" Background="{StaticResource BgSurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ UPLOAD BAR ═══ -->
        <Border Grid.Row="0" Background="{StaticResource BgCardBrush}" CornerRadius="12" Padding="16,12" Margin="24,20,24,0">
            <StackPanel Orientation="Horizontal">
                <Button Content="📂 اختر ملف Excel" Style="{StaticResource PrimaryButton}" Padding="14,8" FontSize="13"
                        Click="PickFile_Click" Height="36"/>
                <TextBlock x:Name="FileNameText" Text="لم يتم اختيار ملف" FontSize="12" VerticalAlignment="Center"
                           Foreground="{StaticResource TextMutedBrush}" Margin="12,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- ═══ PREVIEW SUMMARY ═══ -->
        <Border Grid.Row="1" x:Name="PreviewSummary" Background="{StaticResource BgCardBrush}"
                CornerRadius="12" Padding="16,12" Margin="24,12,24,0" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="إجمالي الصفوف" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="RowCountText" Text="0" FontSize="18" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="المبلغ الإجمالي" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="TotalAmountText" Text="0" FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource AccentPrimaryBrush}"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="مكررات" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="DuplicateCountText" Text="0" FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource AccentDangerBrush}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,12,0">
                    <TextBlock Text="التاريخ:" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <DatePicker x:Name="ImportDate" Height="32" Width="140"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Text="الخط:" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="ImportRouteCombo" Height="32" Width="180" DisplayMemberPath="RouteName" SelectedValuePath="RouteId"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ PREVIEW GRID ═══ -->
        <Border Grid.Row="2" x:Name="PreviewPanel" Background="{StaticResource BgCardBrush}"
                CornerRadius="12" Margin="24,12,24,0" Visibility="Collapsed">
            <DataGrid x:Name="PreviewGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" Background="Transparent" BorderThickness="0"
                      RowBackground="{StaticResource BgCardBrush}"
                      AlternatingRowBackground="{StaticResource BgSurfaceBrush}"
                      Foreground="{StaticResource TextPrimaryBrush}"
                      FontSize="12" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{StaticResource BorderSubtleBrush}"
                      HeadersVisibility="Column">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{StaticResource BgDeepBrush}"/>
                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding rowIndex}" Width="50"/>
                    <DataGridTextColumn Header="رقم الفاتورة" Binding="{Binding invoiceNumber}" Width="120"/>
                    <DataGridTextColumn Header="اسم التاجر (الملف)" Binding="{Binding merchantRaw}" Width="*"/>
                    <DataGridTextColumn Header="التاجر المطابق" Binding="{Binding matchedMerchant}" Width="150"/>
                    <DataGridTextColumn Header="المبلغ" Binding="{Binding amount}" Width="100"/>
                    <DataGridTextColumn Header="الحالة" Binding="{Binding statusText}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ═══ SAVE BAR ═══ -->
        <Border Grid.Row="3" x:Name="SaveBar" Margin="24,12,24,20" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="WarningsText" Grid.Column="0" Text="" FontSize="12"
                           Foreground="{StaticResource AccentWarningBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                <Button Grid.Column="1" x:Name="SaveBtn" Content="💾 حفظ الفواتير" Style="{StaticResource PrimaryButton}"
                        Padding="20,10" FontSize="14" FontWeight="Bold" Click="Save_Click"/>
            </Grid>
        </Border>

        <!-- Loading -->
        <Border x:Name="LoadingOverlay" Grid.RowSpan="4" Background="#88000000" Visibility="Collapsed">
            <TextBlock Text="⏳ جاري المعالجة..." FontSize="16" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>
