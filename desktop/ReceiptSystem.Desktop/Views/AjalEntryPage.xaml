<UserControl x:Class="ReceiptSystem.Desktop.Views.AjalEntryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">

    <Grid x:Name="RootGrid" Background="{StaticResource BgDeepBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ Header ═══ -->
        <Border Grid.Row="0" Background="{StaticResource BgCardBrush}" CornerRadius="12" Margin="16,16,16,8" Padding="20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="📓 إدخال دفتر الآجل" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="التاريخ:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <DatePicker x:Name="dpDate" SelectedDateFormat="Short" Width="150" SelectedDate="{x:Static sys:DateTime.Today}"
                                xmlns:sys="clr-namespace:System;assembly=mscorlib"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ Session Info (Route + Driver + Prefix) ═══ -->
        <Border Grid.Row="1" Background="{StaticResource BgCardBrush}" CornerRadius="12" Margin="16,0,16,8" Padding="20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Route (searchable) -->
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="الخط" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <Grid>
                        <TextBox x:Name="RouteSearchBox" Style="{StaticResource ModernTextBox}" Height="34"
                                 TextChanged="RouteSearch_TextChanged" GotFocus="RouteSearch_GotFocus"/>
                        <Button x:Name="ClearRouteBtn" Content="✕" FontSize="9" Visibility="Collapsed"
                                HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0"
                                Width="18" Height="18" Padding="0" Cursor="Hand"
                                Background="Transparent" BorderThickness="0"
                                Foreground="{StaticResource TextMutedBrush}" Click="ClearRoute_Click"/>
                        <Popup x:Name="RoutePopup" PlacementTarget="{Binding ElementName=RouteSearchBox}"
                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                            <Border Background="{StaticResource BgCardBrush}" CornerRadius="8"
                                    BorderBrush="{StaticResource AccentPrimaryBrush}" BorderThickness="1"
                                    Padding="0" Margin="0,2,0,0" MinWidth="200">
                                <Border.Effect><DropShadowEffect BlurRadius="12" Opacity="0.3" ShadowDepth="4"/></Border.Effect>
                                <ListBox x:Name="RouteResults" MaxHeight="200" BorderThickness="0"
                                         Background="Transparent" Foreground="{StaticResource TextPrimaryBrush}"
                                         FontSize="12" SelectionChanged="RouteResults_SelectionChanged">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="8,6"/><Setter Property="Cursor" Value="Hand"/></Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                            </Border>
                        </Popup>
                    </Grid>
                </StackPanel>

                <!-- Driver (searchable) -->
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="السائق" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <Grid>
                        <TextBox x:Name="DriverSearchBox" Style="{StaticResource ModernTextBox}" Height="34"
                                 TextChanged="DriverSearch_TextChanged" GotFocus="DriverSearch_GotFocus"/>
                        <Button x:Name="ClearDriverBtn" Content="✕" FontSize="9" Visibility="Collapsed"
                                HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0"
                                Width="18" Height="18" Padding="0" Cursor="Hand"
                                Background="Transparent" BorderThickness="0"
                                Foreground="{StaticResource TextMutedBrush}" Click="ClearDriver_Click"/>
                        <Popup x:Name="DriverPopup" PlacementTarget="{Binding ElementName=DriverSearchBox}"
                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                            <Border Background="{StaticResource BgCardBrush}" CornerRadius="8"
                                    BorderBrush="{StaticResource AccentPrimaryBrush}" BorderThickness="1"
                                    Padding="0" Margin="0,2,0,0" MinWidth="200">
                                <Border.Effect><DropShadowEffect BlurRadius="12" Opacity="0.3" ShadowDepth="4"/></Border.Effect>
                                <ListBox x:Name="DriverResults" MaxHeight="200" BorderThickness="0"
                                         Background="Transparent" Foreground="{StaticResource TextPrimaryBrush}"
                                         FontSize="12" SelectionChanged="DriverResults_SelectionChanged">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="8,6"/><Setter Property="Cursor" Value="Hand"/></Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                            </Border>
                        </Popup>
                    </Grid>
                </StackPanel>

                <!-- Prefix -->
                <StackPanel Grid.Column="2" Margin="0,0,0,0" MinWidth="180">
                    <TextBlock Text="البادئة" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="txtPrefix" Width="80" Text="441" IsReadOnly="True"
                                 Style="{StaticResource ModernTextBox}" FontSize="18" FontWeight="Bold"
                                 TextAlignment="Center" Foreground="{StaticResource AccentPrimaryBrush}"/>
                        <Button Content="⚙️" Width="36" Margin="4,0,0,0" Style="{StaticResource PrimaryButton}"
                                Click="BtnChangePrefix_Click" ToolTip="تغيير البادئة"/>
                    </StackPanel>
                </StackPanel>

                <!-- Warning area -->
                <TextBlock x:Name="txtWarning" Grid.Row="1" Grid.ColumnSpan="3" Foreground="#FFFBBF24"
                           FontSize="13" Margin="0,8,0,0" Visibility="Collapsed"/>
            </Grid>
        </Border>

        <!-- ═══ Entry Grid ═══ -->
        <Border Grid.Row="2" Background="{StaticResource BgCardBrush}" CornerRadius="12" Margin="16,0,16,8" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Column Headers -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="#" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="الرقم (آخر 3)" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="Bold"/>
                    <TextBlock Grid.Column="2" Text="الرقم الكامل" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="Bold"/>
                    <TextBlock Grid.Column="3" Text="العميل (اكتب للبحث)" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="Bold"/>
                    <TextBlock Grid.Column="4" Text="المبلغ" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="Bold"/>
                    <TextBlock Grid.Column="5" Text="ملاحظات" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="Bold"/>
                </Grid>

                <!-- Scrollable entry rows -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="pnlRows"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ═══ Footer ═══ -->
        <Border Grid.Row="3" Background="{StaticResource BgCardBrush}" CornerRadius="12" Margin="16,0,16,16" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="الفواتير:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="16" Margin="0,0,8,0"/>
                    <TextBlock x:Name="txtCount" Text="0" Foreground="{StaticResource AccentPrimaryBrush}" FontSize="20" FontWeight="Bold"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button x:Name="btnSave" Content="💾 حفظ الجلسة" Style="{StaticResource PrimaryButton}"
                            MinWidth="150" Click="BtnSave_Click"/>
                    <Button Content="+ خط جديد" Style="{StaticResource PrimaryButton}"
                            MinWidth="120" Margin="8,0,0,0" Click="BtnNewSession_Click"
                            Background="Transparent" BorderBrush="{StaticResource AccentPrimaryBrush}" BorderThickness="1"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
