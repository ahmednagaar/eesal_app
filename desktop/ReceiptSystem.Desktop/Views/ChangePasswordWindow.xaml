<Window x:Class="ReceiptSystem.Desktop.Views.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تغيير كلمة المرور" Width="400" Height="340"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        Background="{StaticResource BgDeepBrush}">
    <Grid x:Name="RootGrid" Margin="24">
        <StackPanel>
            <TextBlock Text="🔐 تغيير كلمة المرور" FontSize="18" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,20"/>

            <TextBlock Text="كلمة المرور الحالية:" FontSize="13"
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
            <PasswordBox x:Name="CurrentPwd" FontSize="14" Padding="8,6" Margin="0,0,0,12"/>

            <TextBlock Text="كلمة المرور الجديدة:" FontSize="13"
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
            <PasswordBox x:Name="NewPwd" FontSize="14" Padding="8,6" Margin="0,0,0,4"/>
            <TextBlock Text="8+ أحرف، رقم واحد على الأقل، حرف كبير واحد على الأقل" FontSize="10"
                       Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12"/>

            <TextBlock Text="تأكيد كلمة المرور الجديدة:" FontSize="13"
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
            <PasswordBox x:Name="ConfirmPwd" FontSize="14" Padding="8,6" Margin="0,0,0,16"/>

            <Button x:Name="ChangeBtn" Content="💾 تغيير كلمة المرور" Style="{StaticResource PrimaryButton}"
                    Padding="16,10" FontSize="14" HorizontalAlignment="Stretch" Click="Change_Click"/>

            <TextBlock x:Name="ErrorText" Text="" FontSize="12" Foreground="{StaticResource AccentDangerBrush}"
                       Margin="0,8,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Window>
