<Window x:Class="ReceiptSystem.Desktop.Views.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تغيير كلمة المرور" Width="420" Height="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent"
        KeyDown="Window_KeyDown">
    <Border Background="{StaticResource BgDeepBrush}" CornerRadius="12"
            BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Border Grid.Row="0" Background="{StaticResource BgCardBrush}"
                    CornerRadius="12,12,0,0" Padding="16,10" MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid>
                    <TextBlock Text="🔐 تغيير كلمة المرور" FontSize="14" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Button Content="✕" FontSize="16" FontWeight="Bold"
                            Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"
                            BorderThickness="0" Cursor="Hand"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Padding="8,2" Click="Cancel_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="8,2">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#44EF4444"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- Content -->
            <Grid Grid.Row="1" Margin="24,16,24,24" FlowDirection="RightToLeft">
                <StackPanel>
                    <TextBlock Text="كلمة المرور الحالية:" FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <PasswordBox x:Name="CurrentPwd" FontSize="14" Padding="8,6" Margin="0,0,0,12"/>

                    <TextBlock Text="كلمة المرور الجديدة:" FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <PasswordBox x:Name="NewPwd" FontSize="14" Padding="8,6" Margin="0,0,0,4"/>
                    <TextBlock Text="8+ أحرف، رقم واحد على الأقل، حرف كبير واحد على الأقل" FontSize="10"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12"/>

                    <TextBlock Text="تأكيد كلمة المرور الجديدة:" FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <PasswordBox x:Name="ConfirmPwd" FontSize="14" Padding="8,6" Margin="0,0,0,16"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="ChangeBtn" Grid.Column="0" Content="💾 تغيير" Style="{StaticResource PrimaryButton}"
                                Padding="16,10" FontSize="14" HorizontalAlignment="Stretch" Click="Change_Click" Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Content="إلغاء" Style="{StaticResource SecondaryButton}"
                                Padding="16,10" FontSize="14" Click="Cancel_Click"/>
                    </Grid>

                    <TextBlock x:Name="ErrorText" Text="" FontSize="12" Foreground="{StaticResource AccentDangerBrush}"
                               Margin="0,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
