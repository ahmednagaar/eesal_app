<UserControl x:Class="ReceiptSystem.Desktop.Views.AjalSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <Grid x:Name="RootGrid" Background="{StaticResource BgSurfaceBrush}">
        <Border Background="{StaticResource BgCardBrush}" CornerRadius="12" Padding="24,20"
                Margin="24,20,24,20" VerticalAlignment="Top" MaxWidth="500" HorizontalAlignment="Right">
            <StackPanel>
                <TextBlock Text="⚙️ إعدادات البادئة" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>

                <TextBlock Text="البادئة الحالية:" FontSize="13" Margin="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBlock x:Name="CurrentPrefixText" Text="—" FontSize="24" FontWeight="Bold"
                           Foreground="{StaticResource AccentPrimaryBrush}" Margin="0,0,0,12"/>

                <TextBlock Text="عتبة التحذير:" FontSize="13" Margin="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBlock x:Name="ThresholdText" Text="—" FontSize="14" Margin="0,0,0,12"/>

                <TextBlock Text="إجمالي الأرقام:" FontSize="13" Margin="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBlock x:Name="TotalDigitsText" Text="—" FontSize="14" Margin="0,0,0,12"/>

                <TextBlock Text="البادئة التالية المتوقعة:" FontSize="13" Margin="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBlock x:Name="NextPrefixText" Text="—" FontSize="14" Margin="0,0,0,20"/>

                <Border Height="1" Background="{StaticResource BorderSubtleBrush}" Margin="0,0,0,16"/>

                <TextBlock Text="تغيير البادئة:" FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>
                <TextBox x:Name="NewPrefixBox" FontSize="16" Padding="10,8" MaxLength="10"/>
                <Button Content="💾 تحديث البادئة" Style="{StaticResource PrimaryButton}"
                        Padding="16,10" FontSize="14" Click="UpdatePrefix_Click" Margin="0,12,0,0"
                        HorizontalAlignment="Stretch"/>
            </StackPanel>
        </Border>

        <Border x:Name="LoadingOverlay" Background="#88000000" Visibility="Collapsed">
            <TextBlock Text="⏳ جاري التحميل..." FontSize="16" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>
