<UserControl x:Class="ReceiptSystem.Desktop.Views.AjalMerchantHistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <Grid x:Name="RootGrid" Background="{StaticResource BgSurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ SEARCH BAR ═══ -->
        <Border Grid.Row="0" Background="{StaticResource BgCardBrush}" CornerRadius="12" Padding="16,12" Margin="24,20,24,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="بحث عن تاجر:" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="MerchantComboBox" Height="36" Width="250" FontSize="13" Padding="8,0"
                          IsEditable="True" StaysOpenOnEdit="True"
                          DisplayMemberPath="merchantName" SelectedValuePath="merchantId"
                          KeyUp="MerchantComboBox_KeyUp"
                          SelectionChanged="MerchantComboBox_SelectionChanged"/>
            </StackPanel>
        </Border>

        <!-- ═══ MERCHANT INFO + SUMMARY ═══ -->
        <Border Grid.Row="1" x:Name="MerchantInfoPanel" Background="{StaticResource BgCardBrush}"
                CornerRadius="12" Padding="16,12" Margin="24,12,24,0" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="MerchantNameText" FontSize="18" FontWeight="Bold"/>
                    <TextBlock x:Name="MerchantDetailsText" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock Text="إجمالي النشط" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="ActiveTotalText" FontSize="24" FontWeight="Bold"
                               Foreground="{StaticResource AccentPrimaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="InvoiceCountText" FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>



        <!-- ═══ INVOICES GRID ═══ -->
        <Border Grid.Row="2" x:Name="InvoicesPanel" Background="{StaticResource BgCardBrush}"
                CornerRadius="12" Margin="24,12,24,20" Visibility="Collapsed">
            <DataGrid x:Name="HistoryGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      Background="Transparent" BorderThickness="0"
                      RowBackground="{StaticResource BgCardBrush}"
                      AlternatingRowBackground="{StaticResource BgSurfaceBrush}"
                      Foreground="{StaticResource TextPrimaryBrush}"
                      FontSize="12" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{StaticResource BorderSubtleBrush}"
                      HeadersVisibility="Column">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{StaticResource BgDeepBrush}"/>
                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="التاريخ" Binding="{Binding date}" Width="100"/>
                    <DataGridTextColumn Header="رقم الفاتورة" Binding="{Binding invoiceNumber}" Width="120"/>
                    <DataGridTextColumn Header="المبلغ" Binding="{Binding amount}" Width="100"/>
                    <DataGridTextColumn Header="الخط" Binding="{Binding routeName}" Width="*"/>
                    <DataGridTextColumn Header="الموظف" Binding="{Binding employeeName}" Width="120"/>
                    <DataGridTextColumn Header="الحالة" Binding="{Binding status}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Loading -->
        <Border x:Name="LoadingOverlay" Grid.RowSpan="3" Background="#88000000" Visibility="Collapsed">
            <TextBlock Text="⏳ جاري التحميل..." FontSize="16" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>
