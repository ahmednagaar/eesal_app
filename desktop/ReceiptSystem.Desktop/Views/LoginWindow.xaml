<Window x:Class="ReceiptSystem.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="نظام البستاوي — تسجيل الدخول"
        Width="480" Height="580"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FlowDirection="RightToLeft">

    <Border CornerRadius="16" Background="{StaticResource BgDeepBrush}"
            BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Border Grid.Row="0" Background="{StaticResource BgSurfaceBrush}"
                    CornerRadius="16,16,0,0" MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid>
                    <TextBlock Text="نظام البستاوي" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="16,0"/>
                    <Button Content="✕" HorizontalAlignment="Left" VerticalAlignment="Center"
                            Margin="10,0" Click="Close_Click"
                            Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"
                            BorderThickness="0" FontSize="16" Cursor="Hand" Padding="6,2"/>
                </Grid>
            </Border>

            <!-- Login Form -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="48,0">

                <!-- Logo / Title -->
                <TextBlock Text="📦" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Text="نظام البستاوي" FontSize="28" FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="نظام إدارة الإيصالات والفواتير" FontSize="13"
                           HorizontalAlignment="Center" Margin="0,4,0,32"
                           Foreground="{StaticResource TextSecondaryBrush}"/>

                <!-- Server URL -->
                <TextBlock Text="عنوان السيرفر" FontSize="12" Margin="0,0,0,6"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBox x:Name="ServerUrlBox" Style="{StaticResource ModernTextBox}"
                         Margin="0,0,0,16"
                         FlowDirection="LeftToRight" FontSize="13"/>

                <!-- Username -->
                <TextBlock Text="اسم المستخدم" FontSize="12" Margin="0,0,0,6"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBox x:Name="UsernameBox" Style="{StaticResource ModernTextBox}"
                         Margin="0,0,0,16"/>

                <!-- Password -->
                <TextBlock Text="كلمة المرور" FontSize="12" Margin="0,0,0,6"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <PasswordBox x:Name="PasswordBox" Style="{StaticResource ModernPasswordBox}"
                             Margin="0,0,0,8"
                             KeyDown="PasswordBox_KeyDown"/>

                <!-- Error Message -->
                <TextBlock x:Name="ErrorText" Text="" FontSize="13"
                           Foreground="{StaticResource AccentDangerBrush}"
                           HorizontalAlignment="Center" Margin="0,4,0,16"
                           Visibility="Collapsed"/>

                <!-- Login Button -->
                <Button x:Name="LoginBtn" Content="🔐  تسجيل الدخول"
                        Style="{StaticResource PrimaryButton}"
                        Click="Login_Click" Height="48" FontSize="16"/>

                <!-- Loading -->
                <TextBlock x:Name="LoadingText" Text="⏳ جاري تسجيل الدخول..."
                           FontSize="13" HorizontalAlignment="Center"
                           Foreground="{StaticResource AccentPrimaryBrush}"
                           Margin="0,12,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
