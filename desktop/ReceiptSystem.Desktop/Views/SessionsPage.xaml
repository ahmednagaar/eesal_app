<UserControl x:Class="ReceiptSystem.Desktop.Views.SessionsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <Grid x:Name="RootGrid" Background="{StaticResource BgSurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ FILTER BAR ═══ -->
        <Border Grid.Row="0" Background="{StaticResource BgCardBrush}" CornerRadius="12" Padding="16,12" Margin="24,20,24,0">
            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="التاريخ" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <DatePicker x:Name="FilterDate" Height="36" Width="160" SelectedDateChanged="Filter_Changed"/>
                </StackPanel>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="السائق" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="FilterDriver" Width="180" Height="36"
                              DisplayMemberPath="fullName" SelectedValuePath="driverId"
                              SelectionChanged="Filter_Changed"/>
                </StackPanel>
                <Button Content="⟳  بحث" Style="{StaticResource PrimaryButton}" Padding="16,6" FontSize="13"
                        VerticalAlignment="Bottom" Click="Search_Click" Height="36"/>
                <Button Content="مسح" Style="{StaticResource SecondaryButton}" Padding="12,6" FontSize="12"
                        VerticalAlignment="Bottom" Margin="8,0,0,0" Click="ClearFilters_Click" Height="36"/>
            </StackPanel>
        </Border>

        <!-- ═══ SESSIONS GRID ═══ -->
        <Border Grid.Row="1" Background="{StaticResource BgCardBrush}" CornerRadius="12" Margin="24,12,24,0" Padding="0">
            <Grid>
                <DataGrid x:Name="SessionsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          Background="Transparent" BorderThickness="0"
                          RowBackground="{StaticResource BgCardBrush}"
                          AlternatingRowBackground="{StaticResource BgSurfaceBrush}"
                          Foreground="{StaticResource TextPrimaryBrush}"
                          FontSize="13" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{StaticResource BorderSubtleBrush}"
                          HeadersVisibility="Column" SelectionMode="Single"
                          SelectionChanged="SessionsGrid_SelectionChanged">

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="{StaticResource BgDeepBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                            <Setter Property="Padding" Value="12,10"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="12,8"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.CellStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="التاريخ" Binding="{Binding sessionDate}" Width="100"/>
                        <DataGridTextColumn Header="السائق" Binding="{Binding driverName}" Width="*"/>
                        <DataGridTextColumn Header="المنطقة" Binding="{Binding routeArea}" Width="*"/>
                        <DataGridTextColumn Header="النطاق" Binding="{Binding receiptRange}" Width="110"/>
                        <DataGridTextColumn Header="العدد" Binding="{Binding count}" Width="60"/>
                        <DataGridTextColumn Header="المبلغ" Binding="{Binding amount}" Width="100"/>
                        <DataGridTextColumn Header="فجوات" Binding="{Binding gaps}" Width="60"/>
                        <DataGridTextColumn Header="الحالة" Binding="{Binding status}" Width="80"/>
                        <DataGridTextColumn Header="المصدر" Binding="{Binding source}" Width="70"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Empty state -->
                <TextBlock x:Name="EmptyState" Text="لا توجد جلسات" Visibility="Collapsed"
                           FontSize="14" Foreground="{StaticResource TextMutedBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ═══ DETAIL / ACTIONS PANEL ═══ -->
        <Border x:Name="DetailPanel" Grid.Row="2" Background="{StaticResource BgCardBrush}"
                CornerRadius="12" Margin="24,12,24,20" Padding="20,14" Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Action Buttons -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock x:Name="DetailTitle" Text="" FontSize="15" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button x:Name="ConfirmBtn" Content="✓ تأكيد / قفل" Style="{StaticResource PrimaryButton}"
                            Padding="14,6" FontSize="12" Click="Confirm_Click" Margin="0,0,8,0"/>
                    <Button x:Name="ReconcileBtn" Content="⚖️ تسوية" Style="{StaticResource SecondaryButton}"
                            Padding="14,6" FontSize="12" Click="Reconcile_Click" Margin="0,0,8,0"/>
                    <Button x:Name="UnlockBtn" Content="🔓 فتح القفل" Style="{StaticResource SecondaryButton}"
                            Padding="14,6" FontSize="12" Click="Unlock_Click" Margin="0,0,8,0" Visibility="Collapsed"/>
                    <Button Content="📋 عرض التفاصيل" Style="{StaticResource SecondaryButton}"
                            Padding="14,6" FontSize="12" Click="ViewDetails_Click"/>
                </StackPanel>

                <!-- Receipts + Gaps detail (shown on "View Details") -->
                <StackPanel x:Name="ReceiptsDetail" Grid.Row="1" Visibility="Collapsed">
                    <!-- Receipts sub-grid -->
                    <Border Background="{StaticResource BgInputBrush}" CornerRadius="8" Padding="12" MaxHeight="220">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <DataGrid x:Name="ReceiptsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                      CanUserAddRows="False" Background="Transparent" BorderThickness="0"
                                      Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"
                                      GridLinesVisibility="None" HeadersVisibility="Column"
                                      SelectionMode="Single">
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                        <Setter Property="Padding" Value="8,6"/>
                                        <Setter Property="FontSize" Value="11"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="رقم الإيصال" Binding="{Binding receiptNumber}" Width="100"/>
                                    <DataGridTextColumn Header="التاجر" Binding="{Binding merchantName}" Width="*"/>
                                    <DataGridTextColumn Header="المبلغ" Binding="{Binding amount}" Width="100"/>
                                    <DataGridTextColumn Header="جزئي" Binding="{Binding partial}" Width="60"/>
                                    <DataGridTextColumn Header="ملاحظات" Binding="{Binding notes}" Width="*"/>
                                    <DataGridTemplateColumn Header="" Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button x:Name="EditReceiptBtn" Content="✏️" FontSize="11" Padding="4,2"
                                                            Click="EditReceipt_Click" Cursor="Hand"
                                                            Background="Transparent" BorderThickness="0"
                                                            Foreground="{StaticResource TextPrimaryBrush}"
                                                            ToolTip="تعديل الإيصال"/>
                                                    <Button x:Name="DeleteReceiptBtn" Content="🗑️" FontSize="11" Padding="4,2"
                                                            Click="DeleteReceipt_Click" Cursor="Hand"
                                                            Background="Transparent" BorderThickness="0"
                                                            Foreground="{StaticResource AccentDangerBrush}"
                                                            ToolTip="حذف الإيصال"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </ScrollViewer>
                    </Border>

                    <!-- Gaps section -->
                    <Border x:Name="GapsSection" Background="{StaticResource BgInputBrush}" CornerRadius="8"
                            Padding="12" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="الفجوات في هذه الجلسة" FontSize="13" FontWeight="Bold" Margin="0,0,0,6"/>
                            <TextBlock x:Name="GapsEmptyLabel" Text="✓ لا توجد فجوات" FontSize="12"
                                       Foreground="{StaticResource AccentSuccessBrush}" Visibility="Collapsed"/>
                            <ItemsControl x:Name="GapsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#33EF4444" CornerRadius="4" Padding="8,4" Margin="0,2">
                                            <TextBlock FontSize="12" Foreground="{StaticResource AccentDangerBrush}">
                                                <Run Text="⚠️ إيصال"/>
                                                <Run Text="{Binding gapNumber}"/>
                                                <Run Text="—"/>
                                                <Run Text="{Binding statusDisplay}"/>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ PAGINATION ═══ -->
        <Border Grid.Row="2" HorizontalAlignment="Center" Margin="0,0,0,4"
                Visibility="{Binding ElementName=DetailPanel, Path=Visibility, Converter={x:Null}}">
            <StackPanel x:Name="PaginationPanel" Orientation="Horizontal" Margin="0,4">
                <Button x:Name="PrevBtn" Content="◀ السابق" Style="{StaticResource SecondaryButton}"
                        Padding="12,6" FontSize="12" Click="Prev_Click" IsEnabled="False"/>
                <TextBlock x:Name="PageInfo" Text="صفحة 1" FontSize="13" Margin="16,0"
                           VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                <Button x:Name="NextBtn" Content="التالي ▶" Style="{StaticResource SecondaryButton}"
                        Padding="12,6" FontSize="12" Click="Next_Click"/>
            </StackPanel>
        </Border>

        <!-- ═══ RECONCILE DIALOG ═══ -->
        <Border x:Name="ReconcileDialog" Grid.RowSpan="3" Background="#CC000000" Visibility="Collapsed">
            <Border Background="{StaticResource BgCardBrush}" CornerRadius="16" Padding="32,24"
                    MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="{StaticResource AccentPrimaryBrush}" BorderThickness="2">
                <StackPanel>
                    <TextBlock Text="⚖️ تسوية الجلسة" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <TextBlock x:Name="ReconcileSessionInfo" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"/>
                    <TextBlock Text="المبلغ النقدي الفعلي:" FontSize="13" Margin="0,0,0,6"/>
                    <TextBox x:Name="ActualCashBox" Style="{StaticResource ModernTextBox}" Height="40" FontSize="15"
                             FlowDirection="LeftToRight" TextAlignment="Right"/>
                    <TextBlock x:Name="ReconcileResult" FontSize="14" FontWeight="Bold"
                               Margin="0,12,0,0" Visibility="Collapsed" HorizontalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                        <Button Content="تسوية" Style="{StaticResource PrimaryButton}" Padding="20,8"
                                Click="ReconcileConfirm_Click" Margin="0,0,8,0"/>
                        <Button Content="إلغاء" Style="{StaticResource SecondaryButton}" Padding="16,8"
                                Click="ReconcileCancel_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- ═══ UNLOCK DIALOG ═══ -->
        <Border x:Name="UnlockDialog" Grid.RowSpan="3" Background="#CC000000" Visibility="Collapsed">
            <Border Background="{StaticResource BgCardBrush}" CornerRadius="16" Padding="32,24"
                    MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="{StaticResource AccentWarningBrush}" BorderThickness="2">
                <StackPanel>
                    <TextBlock Text="🔓 فتح قفل الجلسة" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <TextBlock Text="سبب فتح القفل:" FontSize="13" Margin="0,0,0,6"/>
                    <TextBox x:Name="UnlockReasonBox" Style="{StaticResource ModernTextBox}" Height="60"
                             TextWrapping="Wrap" AcceptsReturn="True"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                        <Button Content="فتح القفل" Style="{StaticResource PrimaryButton}" Padding="20,8"
                                Click="UnlockConfirm_Click" Margin="0,0,8,0"/>
                        <Button Content="إلغاء" Style="{StaticResource SecondaryButton}" Padding="16,8"
                                Click="UnlockCancel_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- ═══ EDIT RECEIPT DIALOG ═══ -->
        <Border x:Name="EditReceiptDialog" Grid.RowSpan="3" Background="#CC000000" Visibility="Collapsed">
            <Border Background="{StaticResource BgCardBrush}" CornerRadius="16" Padding="32,24"
                    MaxWidth="460" HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="{StaticResource AccentPrimaryBrush}" BorderThickness="2">
                <StackPanel>
                    <TextBlock x:Name="EditReceiptTitle" Text="✏️ تعديل الإيصال" FontSize="18" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,0,0,16"/>

                    <TextBlock Text="المبلغ:" FontSize="13" Margin="0,0,0,6"/>
                    <TextBox x:Name="EditAmountBox" Style="{StaticResource ModernTextBox}" Height="38" FontSize="14"
                             FlowDirection="LeftToRight" TextAlignment="Right"/>

                    <TextBlock Text="التاجر:" FontSize="13" Margin="0,12,0,6"/>
                    <ComboBox x:Name="EditMerchantCombo" Height="38" Width="396"
                              DisplayMemberPath="merchantName" SelectedValuePath="merchantId"
                              IsEditable="True" IsTextSearchEnabled="True"/>

                    <CheckBox x:Name="EditPartialCheck" Content="دفعة جزئية" FontSize="13" Margin="0,12,0,0"/>

                    <TextBlock Text="ملاحظات:" FontSize="13" Margin="0,12,0,6"/>
                    <TextBox x:Name="EditNotesBox" Style="{StaticResource ModernTextBox}" Height="60"
                             TextWrapping="Wrap" AcceptsReturn="True"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                        <Button Content="حفظ التعديلات" Style="{StaticResource PrimaryButton}" Padding="20,8"
                                Click="EditReceiptConfirm_Click" Margin="0,0,8,0"/>
                        <Button Content="إلغاء" Style="{StaticResource SecondaryButton}" Padding="16,8"
                                Click="EditReceiptCancel_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Loading -->
        <Border x:Name="LoadingOverlay" Grid.RowSpan="3" Background="#88000000" Visibility="Collapsed">
            <TextBlock Text="⏳ جاري التحميل..." FontSize="16" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>
