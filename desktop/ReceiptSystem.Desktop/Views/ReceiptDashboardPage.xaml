<UserControl x:Class="ReceiptSystem.Desktop.Views.ReceiptDashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <Grid Background="{StaticResource BgSurfaceBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20">
            <StackPanel>

                <!-- ═══ STAT CARDS ═══ -->
                <UniformGrid Columns="4" Margin="0,0,0,16">
                    <!-- Total Amount -->
                    <Border Background="{StaticResource BgCardBrush}" CornerRadius="12" Padding="20,16" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="إجمالي التحصيل اليوم" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="StatTotalAmount" Text="—" FontSize="28" FontWeight="Bold" Margin="0,6,0,0"
                                       Foreground="{StaticResource AccentPrimaryBrush}"/>
                            <TextBlock Text="جنيه" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                    </Border>
                    <!-- Drivers -->
                    <Border Background="{StaticResource BgCardBrush}" CornerRadius="12" Padding="20,16" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="سائقون اليوم" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="StatDrivers" Text="—" FontSize="28" FontWeight="Bold" Margin="0,6,0,0"/>
                            <TextBlock Text="سائق" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                    </Border>
                    <!-- Receipts -->
                    <Border Background="{StaticResource BgCardBrush}" CornerRadius="12" Padding="20,16" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="إيصالات اليوم" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="StatReceipts" Text="—" FontSize="28" FontWeight="Bold" Margin="0,6,0,0"/>
                            <TextBlock Text="إيصال" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                    </Border>
                    <!-- Open Gaps -->
                    <Border Background="{StaticResource BgCardBrush}" CornerRadius="12" Padding="20,16" Margin="0,0,0,0">
                        <StackPanel>
                            <TextBlock Text="فجوات مفتوحة" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="StatOpenGaps" Text="—" FontSize="28" FontWeight="Bold" Margin="0,6,0,0"
                                       Foreground="{StaticResource AccentDangerBrush}"/>
                            <TextBlock Text="فجوة" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- ═══ ALERT BANNERS ═══ -->
                <!-- Missing Drivers (after 3pm) -->
                <Border x:Name="MissingDriversBanner" Visibility="Collapsed"
                        Background="#33FBBF24" CornerRadius="10" Padding="16,12" Margin="0,0,0,10"
                        BorderBrush="{StaticResource AccentWarningBrush}" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       Foreground="{StaticResource AccentWarningBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="سائقون لم يسلّموا اليوم" FontSize="14" FontWeight="Bold"
                                       Foreground="{StaticResource AccentWarningBrush}"/>
                        </StackPanel>
                        <TextBlock x:Name="MissingDriversText" TextWrapping="Wrap" FontSize="13"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Low Stock Books -->
                <Border x:Name="LowStockBanner" Visibility="Collapsed"
                        Background="#33EF4444" CornerRadius="10" Padding="16,12" Margin="0,0,0,10"
                        BorderBrush="{StaticResource AccentDangerBrush}" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       Foreground="{StaticResource AccentDangerBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="دفاتر على وشك النفاد" FontSize="14" FontWeight="Bold"
                                       Foreground="{StaticResource AccentDangerBrush}"/>
                        </StackPanel>
                        <TextBlock x:Name="LowStockText" TextWrapping="Wrap" FontSize="13"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- ═══ SESSIONS TABLE ═══ -->
                <Border Background="{StaticResource BgCardBrush}" CornerRadius="12" Padding="20,16">
                    <StackPanel>
                        <!-- Header -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="جلسات اليوم" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" x:Name="RefreshBtn" Content="⟳  تحديث" Style="{StaticResource SecondaryButton}"
                                    Click="Refresh_Click" Padding="12,6" FontSize="12" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- DataGrid -->
                        <DataGrid x:Name="SessionsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  Background="Transparent" BorderThickness="0"
                                  RowBackground="{StaticResource BgCardBrush}"
                                  AlternatingRowBackground="{StaticResource BgSurfaceBrush}"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  FontSize="13" GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{StaticResource BorderSubtleBrush}"
                                  HeadersVisibility="Column" MinHeight="200"
                                  MouseDoubleClick="SessionsGrid_DoubleClick">

                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="{StaticResource BgDeepBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                    <Setter Property="Padding" Value="12,10"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>

                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Padding" Value="12,8"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="DataGridCell">
                                                <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DataGrid.CellStyle>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="السائق" Binding="{Binding driverName}" Width="*"/>
                                <DataGridTextColumn Header="المنطقة" Binding="{Binding routeArea}" Width="*"/>
                                <DataGridTextColumn Header="نطاق الإيصالات" Binding="{Binding receiptRange}" Width="120"/>
                                <DataGridTextColumn Header="العدد" Binding="{Binding totalReceiptsCount}" Width="70"/>
                                <DataGridTextColumn Header="المبلغ" Binding="{Binding totalAmountFormatted}" Width="100"/>
                                <DataGridTextColumn Header="فجوات" Binding="{Binding gapStatus}" Width="70"/>
                                <DataGridTextColumn Header="المصدر" Binding="{Binding importSource}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Empty State -->
                        <TextBlock x:Name="EmptyState" Text="لا توجد جلسات لليوم بعد"
                                   FontSize="14" Foreground="{StaticResource TextMutedBrush}"
                                   HorizontalAlignment="Center" Margin="0,20" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Loading Overlay -->
        <Border x:Name="LoadingOverlay" Background="#88000000" Visibility="Collapsed">
            <TextBlock Text="⏳ جاري التحميل..." FontSize="16" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>
