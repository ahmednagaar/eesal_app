<UserControl x:Class="ReceiptSystem.Desktop.Views.DriverPerformancePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <Grid x:Name="RootGrid" Background="{StaticResource BgSurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ FILTER BAR ═══ -->
        <Border Grid.Row="0" Background="{StaticResource BgCardBrush}" CornerRadius="12" Padding="16,12" Margin="24,20,24,0">
            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="من تاريخ" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <DatePicker x:Name="DateFrom" Height="34" Width="150"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="إلى تاريخ" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <DatePicker x:Name="DateTo" Height="34" Width="150"/>
                </StackPanel>
                <Button Content="⟳  عرض الأداء" Style="{StaticResource PrimaryButton}" Padding="16,6" FontSize="13"
                        Click="LoadPerformance_Click" VerticalAlignment="Bottom" Height="34"/>
            </StackPanel>
        </Border>

        <!-- ═══ DRIVER CARDS ═══ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="24,12,24,20">
            <StackPanel x:Name="DriverCards"/>
        </ScrollViewer>

        <!-- Loading -->
        <Border x:Name="LoadingOverlay" Grid.RowSpan="2" Background="#88000000" Visibility="Collapsed">
            <TextBlock Text="⏳ جاري التحميل..." FontSize="16" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>
