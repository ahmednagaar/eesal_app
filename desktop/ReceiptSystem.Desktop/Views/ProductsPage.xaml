<UserControl x:Class="ReceiptSystem.Desktop.Views.ProductsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Loaded="Page_Loaded">

    <Grid Background="{StaticResource BgSurfaceBrush}">
        <DockPanel Margin="24,20">

            <!-- Header -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="📦  الأصناف والوحدات" FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                <Button Grid.Column="2" Content="➕ نوع صنف" Style="{StaticResource SecondaryButton}"
                        Click="AddCategory_Click" Padding="16,8" FontSize="13" Margin="8,0"/>
                <Button Grid.Column="3" Content="➕ صنف جديد" Style="{StaticResource PrimaryButton}"
                        Click="AddProduct_Click" Padding="16,8" FontSize="13"/>
            </Grid>

            <!-- Filters -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="CategoryFilter" Grid.Column="0"
                          DisplayMemberPath="categoryName" SelectedValuePath="categoryId"
                          SelectionChanged="CategoryFilter_Changed"
                          FontSize="14" Padding="10,8"/>
                <TextBox x:Name="SearchBox" Grid.Column="2"
                         TextChanged="SearchBox_Changed"
                         FontSize="14" Padding="10,8"
                         Tag="بحث بالاسم أو الكود..."/>
            </Grid>

            <!-- Products Grid -->
            <Border CornerRadius="12" Background="{StaticResource BgCardBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                <DataGrid x:Name="ProductsGrid"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          Background="Transparent" Foreground="{StaticResource TextPrimaryBrush}"
                          BorderThickness="0" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{StaticResource BorderSubtleBrush}"
                          RowBackground="Transparent" AlternatingRowBackground="#08FFFFFF"
                          HeadersVisibility="Column" CanUserResizeRows="False"
                          SelectionMode="Single" FontSize="14"
                          MouseDoubleClick="ProductsGrid_DoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="نوع الصنف" Binding="{Binding [categoryName]}" Width="180"/>
                        <DataGridTextColumn Header="اسم الصنف" Binding="{Binding [productName]}" Width="*"/>
                        <DataGridTextColumn Header="الكود" Binding="{Binding [productCode]}" Width="100"/>
                        <DataGridTextColumn Header="الوحدات" Binding="{Binding [unitsSummary]}" Width="200"/>
                        <DataGridTemplateColumn Header="إجراءات" Width="220">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="📏 وحدات" Tag="{Binding}" Click="ManageUnits_Click"
                                                Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="12" Margin="2"/>
                                        <Button Content="✏️" Tag="{Binding}" Click="EditProduct_Click"
                                                Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="12" Margin="2"/>
                                        <Button Content="🗑️" Tag="{Binding}" Click="DeleteProduct_Click"
                                                Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="12" Margin="2"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </DockPanel>

        <!-- ═══ PRODUCT DIALOG ═══ -->
        <Grid x:Name="ProductDialog" Visibility="Collapsed" Background="#88000000">
            <Border CornerRadius="16" Background="{StaticResource BgCardBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                    Width="500" VerticalAlignment="Center" Padding="28,24">
                <StackPanel>
                    <TextBlock x:Name="ProductDialogTitle" Text="إضافة صنف جديد" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>
                    <TextBlock Text="نوع الصنف:" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="ProductCategoryCombo" DisplayMemberPath="categoryName" SelectedValuePath="categoryId"
                              FontSize="14" Padding="10,8" Margin="0,0,0,12"/>
                    <TextBlock Text="اسم الصنف:" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="ProductNameBox" FontSize="14" Padding="10,8" Margin="0,0,0,12"/>
                    <TextBlock Text="كود الصنف (اختياري):" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="ProductCodeBox" FontSize="14" Padding="10,8" Margin="0,0,0,12"/>
                    <TextBlock x:Name="ProductDialogError" Foreground="#FF6B6B" FontSize="13" Visibility="Collapsed" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,8,0,0">
                        <Button Content="حفظ" Style="{StaticResource PrimaryButton}" Click="SaveProduct_Click" Padding="24,10" FontSize="14"/>
                        <Button Content="إلغاء" Style="{StaticResource SecondaryButton}" Click="CancelProductDialog_Click" Padding="24,10" FontSize="14" Margin="12,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══ CATEGORY DIALOG ═══ -->
        <Grid x:Name="CategoryDialog" Visibility="Collapsed" Background="#88000000">
            <Border CornerRadius="16" Background="{StaticResource BgCardBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                    Width="420" VerticalAlignment="Center" Padding="28,24">
                <StackPanel>
                    <TextBlock x:Name="CategoryDialogTitle" Text="إضافة نوع صنف" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>
                    <TextBlock Text="اسم النوع:" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="CategoryNameBox" FontSize="14" Padding="10,8" Margin="0,0,0,12"/>
                    <TextBlock x:Name="CategoryDialogError" Foreground="#FF6B6B" FontSize="13" Visibility="Collapsed" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,8,0,0">
                        <Button Content="حفظ" Style="{StaticResource PrimaryButton}" Click="SaveCategory_Click" Padding="24,10" FontSize="14"/>
                        <Button Content="إلغاء" Style="{StaticResource SecondaryButton}" Click="CancelCategoryDialog_Click" Padding="24,10" FontSize="14" Margin="12,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══ UNITS MANAGEMENT DIALOG ═══ -->
        <Grid x:Name="UnitsDialog" Visibility="Collapsed" Background="#88000000">
            <Border CornerRadius="16" Background="{StaticResource BgCardBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                    Width="600" MaxHeight="500" VerticalAlignment="Center" Padding="28,24">
                <DockPanel>
                    <TextBlock x:Name="UnitsDialogTitle" DockPanel.Dock="Top" Text="وحدات الصنف" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>

                    <!-- Add Unit Row -->
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="AddUnitCombo" Grid.Column="0" DisplayMemberPath="unitName" SelectedValuePath="unitId"
                                  FontSize="14" Padding="10,8"/>
                        <CheckBox x:Name="AddUnitDefault" Grid.Column="1" Content="افتراضي" VerticalAlignment="Center"
                                  Foreground="{StaticResource TextSecondaryBrush}" Margin="12,0"/>
                        <Button Grid.Column="2" Content="➕ إضافة" Style="{StaticResource PrimaryButton}"
                                Click="AddUnitToProduct_Click" Padding="16,8" FontSize="13"/>
                    </Grid>

                    <TextBlock x:Name="UnitsDialogError" DockPanel.Dock="Top" Foreground="#FF6B6B" FontSize="13" Visibility="Collapsed" Margin="0,0,0,8"/>

                    <!-- Close button -->
                    <Button DockPanel.Dock="Bottom" Content="إغلاق" Style="{StaticResource SecondaryButton}"
                            Click="CloseUnitsDialog_Click" HorizontalAlignment="Left" Padding="24,10" FontSize="14" Margin="0,12,0,0"/>

                    <!-- Units Grid -->
                    <DataGrid x:Name="UnitsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              Background="Transparent" Foreground="{StaticResource TextPrimaryBrush}"
                              BorderThickness="0" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{StaticResource BorderSubtleBrush}"
                              RowBackground="Transparent" HeadersVisibility="Column"
                              CanUserResizeRows="False" FontSize="14">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الوحدة" Binding="{Binding [unitName]}" Width="*"/>
                            <DataGridTextColumn Header="افتراضي" Binding="{Binding [isDefaultText]}" Width="80"/>
                            <DataGridTemplateColumn Header="" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="🗑️" Tag="{Binding}" Click="RemoveUnit_Click"
                                                Style="{StaticResource SecondaryButton}" Padding="6,3" FontSize="12"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
