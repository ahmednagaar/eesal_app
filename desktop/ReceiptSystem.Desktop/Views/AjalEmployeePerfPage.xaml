<UserControl x:Class="ReceiptSystem.Desktop.Views.AjalEmployeePerfPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <Grid x:Name="RootGrid" Background="{StaticResource BgSurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ DATE RANGE BAR ═══ -->
        <Border Grid.Row="0" Background="{StaticResource BgCardBrush}" CornerRadius="12" Padding="16,12" Margin="24,20,24,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="من:" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <DatePicker x:Name="DateFrom" Height="36" Width="150" Margin="0,0,16,0"/>
                    <TextBlock Text="إلى:" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <DatePicker x:Name="DateTo" Height="36" Width="150"/>
                    <Button Content="📊 عرض" Style="{StaticResource PrimaryButton}" Padding="14,6" FontSize="13"
                            Click="Load_Click" Height="36" Margin="12,0,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="اليوم" Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="11"
                            Click="Today_Click" Height="30" Margin="0,0,6,0"/>
                    <Button Content="هذا الأسبوع" Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="11"
                            Click="Week_Click" Height="30" Margin="0,0,6,0"/>
                    <Button Content="هذا الشهر" Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="11"
                            Click="Month_Click" Height="30" Margin="0,0,6,0"/>
                    <Button x:Name="ExportBtn" Content="📥 تصدير" Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="11"
                            Click="Export_Click" Height="30" IsEnabled="False"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ GRAND TOTALS ═══ -->
        <UniformGrid Grid.Row="1" Columns="3" Margin="24,12,24,0">
            <Border Background="{StaticResource BgCardBrush}" CornerRadius="10" Padding="14,10" Margin="0,0,10,0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="إجمالي الفواتير" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="GrandInvoices" Text="—" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Border Background="{StaticResource BgCardBrush}" CornerRadius="10" Padding="14,10" Margin="0,0,10,0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="إجمالي المبلغ" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="GrandAmount" Text="—" FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource AccentPrimaryBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Border Background="{StaticResource BgCardBrush}" CornerRadius="10" Padding="14,10">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="عدد الموظفين" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="EmployeeCount" Text="—" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- ═══ EMPLOYEE TABLE ═══ -->
        <Border Grid.Row="2" Background="{StaticResource BgCardBrush}" CornerRadius="12" Margin="24,12,24,20">
            <DataGrid x:Name="EmployeeGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" Background="Transparent" BorderThickness="0"
                      RowBackground="{StaticResource BgCardBrush}"
                      AlternatingRowBackground="{StaticResource BgSurfaceBrush}"
                      Foreground="{StaticResource TextPrimaryBrush}"
                      FontSize="13" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{StaticResource BorderSubtleBrush}"
                      HeadersVisibility="Column">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{StaticResource BgDeepBrush}"/>
                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                        <Setter Property="Padding" Value="12,10"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="12,8"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.CellStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding rank}" Width="50"/>
                    <DataGridTextColumn Header="اسم الموظف" Binding="{Binding name}" Width="*"/>
                    <DataGridTextColumn Header="عدد الفواتير" Binding="{Binding count}" Width="100"/>
                    <DataGridTextColumn Header="الإجمالي" Binding="{Binding total}" Width="120"/>
                    <DataGridTextColumn Header="متوسط الفاتورة" Binding="{Binding avg}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Loading -->
        <Border x:Name="LoadingOverlay" Grid.RowSpan="3" Background="#88000000" Visibility="Collapsed">
            <TextBlock Text="⏳ جاري التحميل..." FontSize="16" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>
